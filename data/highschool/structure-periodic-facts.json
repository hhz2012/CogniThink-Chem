{
  "version": "1.0",
  "source": "T3 物质结构与元素周期律/化学用语文子集（同位素/同素异形体/晶体类型/化学用语/周期律推断）事实库；人工逐核，以 llmReference 反推真值校验。",
  "statements": [
    { "id": "SF-069-A", "match": ["强酸性"], "stemMatch": ["甲硅烷", "高锰酸钾"], "verdict": false, "reason": "产物含 SiO3²⁻，强酸性下不能存在，故反应不在强酸性环境中进行。" },
    { "id": "SF-069-B", "match": ["SiH4", "沸点", "(CH3)4Si"], "stemMatch": ["甲硅烷", "高锰酸钾"], "verdict": true, "reason": "SiH4 分子量小、分子间作用力弱，沸点低于四甲基硅烷 (CH3)4Si。" },
    { "id": "SF-069-C", "match": ["溶液", "紫红色"], "stemMatch": ["甲硅烷", "高锰酸钾"], "verdict": false, "reason": "MnO4⁻ 被还原为 MnO2，紫红色褪去，不会变成紫红色。" },
    { "id": "SF-069-D", "match": ["SiH4", "被还原"], "stemMatch": ["甲硅烷", "高锰酸钾"], "verdict": false, "reason": "Si 由 −4 升到 +4，SiH4 被氧化，不是被还原。" },

    { "id": "SF-154-A", "match": ["氮的固定"], "stemMatch": ["MOFs", "N2O4"], "verdict": false, "reason": "氮的固定指 N2 转化为含氮化合物，此处是 NO2 转化为 HNO3，不属于氮的固定。" },
    { "id": "SF-154-B", "match": ["固定", "超分子", "识别"], "stemMatch": ["MOFs", "N2O4"], "verdict": true, "reason": "MOFs 孔径与 N2O4 匹配将其固定，体现超分子的识别功能。" },
    { "id": "SF-154-C", "match": ["温度升高", "N2O4", "固定"], "stemMatch": ["MOFs", "N2O4"], "verdict": false, "reason": "升温使 2NO2⇌N2O4 逆向移动，不利于 N2O4 的固定。" },
    { "id": "SF-154-D", "match": ["原子利用率", "83%"], "stemMatch": ["MOFs", "N2O4"], "verdict": false, "reason": "3NO2 + H2O = 2HNO3 + NO，原子利用率不是 83%。" },

    { "id": "SF-181-A", "match": ["同素异形体"], "stemMatch": ["14N", "15N"], "verdict": false, "reason": "¹⁴N 与 ¹⁵N 是同位素，不是同素异形体。" },
    { "id": "SF-181-B", "match": ["同种核素"], "stemMatch": ["14N", "15N"], "verdict": false, "reason": "二者中子数不同，属于不同核素。" },
    { "id": "SF-181-C", "match": ["14N", "15N", "中子"], "stemMatch": ["14N", "15N"], "verdict": true, "reason": "¹⁴N 有 7 个中子，¹⁵N 有 8 个中子，¹⁴N 比 ¹⁵N 少一个中子。" },
    { "id": "SF-181-D", "match": ["质子"], "stemMatch": ["14N", "15N"], "verdict": false, "reason": "二者质子数相同（均为 7）。" },

    { "id": "SF-183-A", "match": ["31H", "电子数"], "stemMatch": ["氚"], "verdict": true, "reason": "³₁H 核外电子数 = 质子数 = 1。" },
    { "id": "SF-183-B", "match": ["31H", "中子数"], "stemMatch": ["氚"], "verdict": false, "reason": "³₁H 中子数 = 质量数 − 质子数 = 3 − 1 = 2，不是 3。" },
    { "id": "SF-183-C", "match": ["31H2", "化学性质"], "stemMatch": ["氚"], "verdict": true, "reason": "同位素化学性质基本相同。" },
    { "id": "SF-183-D", "match": ["31H2O", "放射性"], "stemMatch": ["氚"], "verdict": true, "reason": "氚水具有放射性。" },

    { "id": "SF-186-A", "match": ["113/49In"], "stemMatch": ["铟", "原子序数为49"], "verdict": true, "reason": "铟 Z=49，¹¹³₄₉In 书写正确。" },
    { "id": "SF-186-B", "match": ["49/11In"], "stemMatch": ["铟", "原子序数为49"], "verdict": false, "reason": "下标（质子数）应为 49，此选项将质量数与质子数颠倒。" },
    { "id": "SF-186-C", "match": ["49/114In"], "stemMatch": ["铟", "原子序数为49"], "verdict": false, "reason": "质子数位置书写错误，应为下标 49。" },
    { "id": "SF-186-D", "match": ["49/115In"], "stemMatch": ["铟", "原子序数为49"], "verdict": false, "reason": "质子数位置书写错误，应为下标 49。" },

    { "id": "SF-192-A", "match": ["CS2"], "stemMatch": ["极性分子"], "verdict": false, "reason": "CS2 为直线形，结构对称，是非极性分子。" },
    { "id": "SF-192-B", "match": ["NF3"], "stemMatch": ["极性分子"], "verdict": true, "reason": "NF3 为三角锥形，正电中心与负电中心不重合，是极性分子。" },
    { "id": "SF-192-C", "match": ["SO3"], "stemMatch": ["极性分子"], "verdict": false, "reason": "SO3 为平面三角形，结构对称，是非极性分子。" },
    { "id": "SF-192-D", "match": ["SiF4"], "stemMatch": ["极性分子"], "verdict": false, "reason": "SiF4 为正四面体形，结构对称，是非极性分子。" },

    { "id": "SF-200-A", "match": ["周期性有序", "相同的物理性质"], "stemMatch": ["晶体和非晶体"], "verdict": false, "reason": "晶体具有各向异性，不同方向物理性质不同。" },
    { "id": "SF-200-B", "match": ["熔化", "温度不断地升高"], "stemMatch": ["晶体和非晶体"], "verdict": false, "reason": "晶体熔化时温度保持不变。" },
    { "id": "SF-200-C", "match": ["普通玻璃", "性质相同"], "stemMatch": ["晶体和非晶体"], "verdict": true, "reason": "普通玻璃是非晶体，具有各向同性，各方向性质相同。" },
    { "id": "SF-200-D", "match": ["不可以相互转化"], "stemMatch": ["晶体和非晶体"], "verdict": false, "reason": "晶体和非晶体在一定条件下可以相互转化。" },

    { "id": "SF-209-A", "match": ["金刚石"], "stemMatch": ["共价晶体", "熔点最低"], "verdict": false, "reason": "C—C 键键能最大，金刚石熔点最高。" },
    { "id": "SF-209-B", "match": ["单晶硅"], "stemMatch": ["共价晶体", "熔点最低"], "verdict": true, "reason": "Si—Si 键键能最小，单晶硅熔点最低。" },
    { "id": "SF-209-C", "match": ["金刚砂"], "stemMatch": ["共价晶体", "熔点最低"], "verdict": false, "reason": "Si—C 键强于 Si—Si，金刚砂熔点高于单晶硅。" },
    { "id": "SF-209-D", "match": ["氮化硼"], "stemMatch": ["共价晶体", "熔点最低"], "verdict": false, "reason": "B—N 键强于 Si—Si，氮化硼熔点高于单晶硅。" },

    { "id": "SF-210-A", "match": ["石蜡油", "流动性", "分子间作用力比水的小"], "stemMatch": ["解释错误"], "verdict": false, "reason": "石蜡油流动性差是因为其分子间作用力比水大，解释错误。" },
    { "id": "SF-210-B", "match": ["NH3", "碱性", "质子"], "stemMatch": ["解释错误"], "verdict": true, "reason": "NH3 可结合水中质子生成 NH4+，使溶液显碱性。" },
    { "id": "SF-210-C", "match": ["OF2", "氧化H2O", "O显正电性"], "stemMatch": ["解释错误"], "verdict": true, "reason": "OF2 中 O 显 +2 价（正电性），可氧化 H2O。" },
    { "id": "SF-210-D", "match": ["石墨", "润滑剂", "范德华力"], "stemMatch": ["解释错误"], "verdict": true, "reason": "石墨层间靠范德华力维系，易滑动，可作润滑剂。" },

    { "id": "SF-320-A", "match": ["32S2", "34S4", "同位素"], "verdict": false, "reason": "同位素的研究对象是原子，S2 与 S4 是分子，不互为同位素。" },
    { "id": "SF-320-B", "match": ["C70", "纳米碳管", "同素异形体"], "verdict": true, "reason": "C70 与纳米碳管都是碳元素形成的单质，互为同素异形体。" },
    { "id": "SF-320-C", "match": ["H-C-Cl", "Cl-C-Cl", "同分异构体"], "verdict": false, "reason": "结构不完整且分子式/组成不同，不互为同分异构体。" },
    { "id": "SF-320-D", "match": ["双酚A", "苯酚", "同系物"], "verdict": false, "reason": "双酚 A 与苯酚结构不相似（官能团数目/碳架不同），不互为同系物。" },

    { "id": "SF-326-A", "match": ["721分光光度计", "X射线"], "verdict": false, "reason": "721 分光光度计使用可见-紫外光，不能产生 X 射线。" },
    { "id": "SF-326-B", "match": ["相对分子质量为72", "分子式一定为C5H12"], "verdict": false, "reason": "相对分子质量为 72 还可能是 C4H8O、C3H4O2 等，不一定是 C5H12。" },
    { "id": "SF-326-C", "match": ["乙酸", "甲酸甲酯", "核磁共振氢谱", "完全相同"], "verdict": false, "reason": "乙酸与甲酸甲酯的核磁共振氢谱化学位移、峰数不完全相同。" },
    { "id": "SF-326-D", "match": ["红外光谱", "化学键或官能团"], "verdict": true, "reason": "红外光谱图可获得分子中化学键或官能团的信息。" },

    { "id": "SF-430-A", "match": ["中子数为1的氦", "1/2He"], "stemMatch": ["化学用语或表述正确"], "verdict": false, "reason": "中子数为 1 的氦核素质量数为 3，应为 ³₂He，不是 ¹₂He。" },
    { "id": "SF-430-B", "match": ["SiO2", "分子晶体"], "stemMatch": ["化学用语或表述正确"], "verdict": false, "reason": "SiO2 是共价（原子）晶体，不是分子晶体。" },
    { "id": "SF-430-C", "match": ["F2", "p-p", "σ键"], "stemMatch": ["化学用语或表述正确"], "verdict": true, "reason": "F2 中两个 F 原子的 p 轨道头碰头重叠，形成 p-p σ 键。" },
    { "id": "SF-430-D", "match": ["PCl3", "平面三角形"], "stemMatch": ["化学用语或表述正确"], "verdict": false, "reason": "PCl3 中心 P 有一对孤对电子，空间结构为三角锥形，不是平面三角形。" },

    { "id": "SF-499-A", "match": ["Na2SiF6", "配位键"], "verdict": true, "reason": "SiF6²⁻ 中 F⁻ 提供孤对电子与 Si 形成配位键。" },
    { "id": "SF-499-B", "match": ["SiF4", "极性分子"], "verdict": false, "reason": "SiF4 为正四面体形，结构对称，是非极性分子。" },
    { "id": "SF-499-C", "match": ["CO2", "分子晶体", "SiO2", "共价晶体"], "verdict": true, "reason": "CO2 是分子晶体，SiO2 是共价晶体。" },
    { "id": "SF-499-D", "match": ["CO3", "VSEPR", "平面三角形"], "verdict": true, "reason": "CO3²⁻ 的 VSEPR 模型和空间结构均为平面三角形。" },

    { "id": "SF-500-A", "match": ["CH4", "H2O", "VSEPR", "四面体"], "verdict": true, "reason": "CH4 和 H2O 中心原子价层电子对数均为 4，VSEPR 模型均为四面体。" },
    { "id": "SF-500-B", "match": ["SO3", "CO3", "平面三角形"], "verdict": false, "reason": "SO3²⁻ 中心 S 有一对孤对电子，空间结构为三角锥形，不是平面三角形。" },
    { "id": "SF-500-C", "match": ["CF4", "SF4", "非极性分子"], "verdict": false, "reason": "SF4 为变形四面体（有孤对电子），是极性分子。" },
    { "id": "SF-500-D", "match": ["XeF2", "XeO2", "键角相等"], "verdict": false, "reason": "XeF2 为直线形，XeO2 为 V 形，键角不相等。" },

    { "id": "SF-501-A", "match": ["原子光谱", "线状", "量子化"], "verdict": true, "reason": "原子光谱是不连续的线状谱，因为原子能级是量子化的。" },
    { "id": "SF-501-B", "match": ["CO2", "CH2O", "CCl4", "键角", "孤电子对"], "verdict": false, "reason": "CO2、CH2O、CCl4 键角不同的主因是中心原子杂化方式不同（sp/sp²/sp³），不是孤对电子斥力。" },
    { "id": "SF-501-C", "match": ["CsCl", "8个", "NaCl", "6个", "半径大"], "verdict": true, "reason": "Cs⁺ 半径比 Na⁺ 大，CsCl 配位数为 8，NaCl 配位数为 6。" },
    { "id": "SF-501-D", "match": ["断开", "CH4", "C-H", "能量不同", "化学环境"], "verdict": true, "reason": "逐个断开 CH4 中 C—H 时各步剩余基团不同，C—H 所处化学环境不同，能量不同。" },

    { "id": "SF-502-A", "match": ["电负性", "C>O"], "verdict": false, "reason": "电负性 O > C。" },
    { "id": "SF-502-B", "match": ["价电子数", "S>N"], "verdict": true, "reason": "S 价电子数为 6，N 为 5，故 S > N。" },
    { "id": "SF-502-C", "match": ["原子半径", "N>C"], "verdict": false, "reason": "同周期从左到右原子半径减小，C > N。" },
    { "id": "SF-502-D", "match": ["键角", "NH3>CH4"], "verdict": false, "reason": "NH3 有一对孤对电子，键角小于 CH4。" },

    { "id": "SF-495-A", "match": ["电负性", "B>N>O"], "stemMatch": ["构建化合物的常见元素"], "verdict": false, "reason": "电负性 O(3.44) > N(3.04) > B(2.04)，应为 O>N>B，故 B>N>O 错误。" },
    { "id": "SF-495-B", "match": ["离子半径", "P3-<S2-<Cl-"], "stemMatch": ["构建化合物的常见元素"], "verdict": false, "reason": "等电子离子 P³⁻、S²⁻、Cl⁻ 半径随核电荷数增大而减小，应为 P3->S2->Cl-，故 P3-<S2-<Cl- 错误。" },
    { "id": "SF-495-C", "match": ["第一电离能", "Ge<Se<As"], "stemMatch": ["构建化合物的常见元素"], "verdict": true, "reason": "第一电离能 Ge<Se<As（As 的 4p³ 半满稳定，第一电离能高于 Se），排序正确。" },
    { "id": "SF-495-D", "match": ["Cr2+", "[Ar]3d4"], "stemMatch": ["构建化合物的常见元素"], "verdict": true, "reason": "Cr 基态 [Ar]3d⁵4s¹，Cr²⁺ 失去 4s¹ 与一个 3d 电子，简化电子排布式为 [Ar]3d⁴，正确。" },

    { "id": "SF-225-A", "match": ["电负性", "F>O>N>H>C"], "stemMatch": ["某种超分子的结构如图所示"], "verdict": false, "reason": "电负性同周期 C<N<O<F，且 CH₄ 中 H 为 +1、C 为 -4，故 H<C，正确排序为 F>O>N>C>H；选项 F>O>N>H>C（H>C）错误。" },
    { "id": "SF-225-B", "match": ["p区元素"], "stemMatch": ["某种超分子的结构如图所示"], "verdict": false, "reason": "该超分子含 H 元素，H 属 s 区，并非所涉元素均为 p 区元素。" },
    { "id": "SF-225-C", "match": ["分子识别和自组装"], "stemMatch": ["某种超分子的结构如图所示"], "verdict": true, "reason": "超分子通过分子间弱相互作用形成，具有分子识别和自组装的特征。" },
    { "id": "SF-225-D", "match": ["配位键", "N原子提供孤电子对"], "stemMatch": ["某种超分子的结构如图所示"], "verdict": true, "reason": "B 原子 sp³ 杂化后有空轨道，N 原子有孤电子对，B—N 配位键中 N 原子提供孤电子对。" },

    { "id": "SF-486-A", "match": ["Ar", "只有一种"], "stemMatch": ["单核微粒"], "verdict": true, "reason": "Ar 基态原子电子排布式唯一（1s²2s²2p⁶3s²3p⁶），说法正确。" },
    { "id": "SF-486-B", "match": ["第二电离能", "第一电离能"], "stemMatch": ["单核微粒"], "verdict": true, "reason": "Na⁺ 与 Ne 同电子构型但核电荷数更大，Na 的第二电离能大于 Ne 的第一电离能，说法正确。" },
    { "id": "SF-486-C", "match": ["Ge", "4s2 4p2"], "stemMatch": ["单核微粒"], "verdict": false, "reason": "Ge 基态简化电子排布式应为 [Ar]3d¹⁰4s²4p²，漏写 3d¹⁰，选项错误。" },
    { "id": "SF-486-D", "match": ["Fe", "3d轨道"], "stemMatch": ["单核微粒"], "verdict": false, "reason": "Fe 原子失电子先失去 4s 轨道电子，变为 Fe⁺ 时优先失去的是 4s 电子而非 3d，选项错误。" }
  ]
}
