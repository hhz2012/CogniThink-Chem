{
  "version": "1.0",
  "source": "T1 子集反推 + 人教版高中化学（离子共存）。仅收录高置信度冲突对；condition 缺省为 any。",
  "rules": [
    { "ions": ["S2O3^2-", "H+"], "type": "gas", "result": "S2O3^2- 与 H+ 反应生成 S 和 SO2" },
    { "ions": ["CO3^2-", "H+"], "type": "gas", "result": "CO3^2- 与 H+ 反应放出 CO2" },
    { "ions": ["HCO3-", "H+"], "type": "gas", "result": "HCO3- 与 H+ 反应放出 CO2" },
    { "ions": ["SO3^2-", "H+"], "type": "gas", "result": "SO3^2- 与 H+ 反应放出 SO2" },
    { "ions": ["HSO3-", "H+"], "type": "gas", "result": "HSO3- 与 H+ 反应放出 SO2" },
    { "ions": ["S2-", "H+"], "type": "gas", "result": "S2- 与 H+ 反应生成 H2S" },
    { "ions": ["HS-", "H+"], "type": "gas", "result": "HS- 与 H+ 反应生成 H2S" },
    { "ions": ["H+", "OH-"], "type": "weak_electrolyte", "result": "H+ 与 OH- 生成水" },
    { "ions": ["NH4+", "OH-"], "type": "weak_electrolyte", "result": "NH4+ 与 OH- 生成 NH3·H2O" },
    { "ions": ["CH3COO-", "H+"], "type": "weak_electrolyte", "result": "CH3COO- 与 H+ 生成弱电解质 CH3COOH" },
    { "ions": ["ClO-", "H+"], "type": "weak_electrolyte", "result": "ClO- 与 H+ 生成弱电解质 HClO" },
    { "ions": ["F-", "H+"], "type": "weak_electrolyte", "result": "F- 与 H+ 生成弱电解质 HF" },

    { "ions": ["Ag+", "Br-"], "type": "precipitation", "result": "Ag+ 与 Br- 生成 AgBr 沉淀" },
    { "ions": ["Ag+", "Cl-"], "type": "precipitation", "result": "Ag+ 与 Cl- 生成 AgCl 沉淀" },
    { "ions": ["Ag+", "CO3^2-"], "type": "precipitation", "result": "Ag+ 与 CO3^2- 生成 Ag2CO3 沉淀" },
    { "ions": ["Ag+", "I-"], "type": "precipitation", "result": "Ag+ 与 I- 生成 AgI 沉淀" },
    { "ions": ["Ag+", "OH-"], "type": "precipitation", "result": "Ag+ 与 OH- 生成 Ag2O 沉淀" },
    { "ions": ["Ag+", "SO3^2-"], "type": "precipitation", "result": "Ag+ 与 SO3^2- 生成 Ag2SO3 沉淀" },
    { "ions": ["Ba2+", "SO4^2-"], "type": "precipitation", "result": "Ba2+ 与 SO4^2- 生成 BaSO4 沉淀" },
    { "ions": ["Ba2+", "CO3^2-"], "type": "precipitation", "result": "Ba2+ 与 CO3^2- 生成 BaCO3 沉淀" },
    { "ions": ["Ba2+", "SO3^2-"], "type": "precipitation", "result": "Ba2+ 与 SO3^2- 生成 BaSO3 沉淀" },
    { "ions": ["Ca2+", "CO3^2-"], "type": "precipitation", "result": "Ca2+ 与 CO3^2- 生成 CaCO3 沉淀" },
    { "ions": ["Ca2+", "SiO3^2-"], "type": "precipitation", "result": "Ca2+ 与 SiO3^2- 生成 CaSiO3 沉淀" },
    { "ions": ["Ca2+", "SO3^2-"], "type": "precipitation", "result": "Ca2+ 与 SO3^2- 生成 CaSO3 沉淀" },
    { "ions": ["Pb2+", "S2-"], "type": "precipitation", "result": "Pb2+ 与 S2- 生成 PbS 沉淀" },
    { "ions": ["Cu2+", "OH-"], "type": "precipitation", "result": "Cu2+ 与 OH- 生成 Cu(OH)2 沉淀" },
    { "ions": ["Fe3+", "OH-"], "type": "precipitation", "result": "Fe3+ 与 OH- 生成 Fe(OH)3 沉淀" },
    { "ions": ["Fe2+", "OH-"], "type": "precipitation", "result": "Fe2+ 与 OH- 生成 Fe(OH)2 沉淀" },
    { "ions": ["Al3+", "OH-"], "type": "precipitation", "result": "Al3+ 与 OH- 生成 Al(OH)3 沉淀" },
    { "ions": ["Mg2+", "OH-"], "type": "precipitation", "result": "Mg2+ 与 OH- 生成 Mg(OH)2 沉淀" },
    { "ions": ["Zn2+", "OH-"], "type": "precipitation", "result": "Zn2+ 与 OH- 生成 Zn(OH)2 沉淀" },

    { "ions": ["Fe3+", "I-"], "type": "redox", "result": "Fe3+ 氧化 I-，不能共存" },
    { "ions": ["Fe3+", "S2-"], "type": "redox", "result": "Fe3+ 与 S2- 发生氧化还原，不能共存" },
    { "ions": ["NO3-", "I-"], "condition": "acidic", "type": "redox", "result": "酸性下 NO3- 氧化 I-，不能共存" },
    { "ions": ["NO3-", "Fe2+"], "condition": "acidic", "type": "redox", "result": "酸性下 NO3- 氧化 Fe2+，不能共存" },
    { "ions": ["NO3-", "S2-"], "condition": "acidic", "type": "redox", "result": "酸性下 NO3- 氧化 S2-，不能共存" },
    { "ions": ["NO3-", "SO3^2-"], "condition": "acidic", "type": "redox", "result": "酸性下 NO3- 氧化 SO3^2-，不能共存" },
    { "ions": ["MnO4-", "Cl-"], "condition": "acidic", "type": "redox", "result": "酸性下 MnO4- 氧化 Cl-，不能共存" },
    { "ions": ["MnO4-", "Fe2+"], "condition": "acidic", "type": "redox", "result": "酸性下 MnO4- 氧化 Fe2+，不能共存" },
    { "ions": ["MnO4-", "I-"], "condition": "acidic", "type": "redox", "result": "酸性下 MnO4- 氧化 I-，不能共存" },
    { "ions": ["MnO4-", "Br-"], "condition": "acidic", "type": "redox", "result": "酸性下 MnO4- 氧化 Br-，不能共存" },
    { "ions": ["MnO4-", "C2H5OH"], "condition": "acidic", "type": "redox", "result": "酸性下 MnO4- 氧化乙醇，不能共存" },
    { "ions": ["Cr2O7^2-", "Fe2+"], "condition": "acidic", "type": "redox", "result": "酸性下 Cr2O7^2- 氧化 Fe2+，不能共存" },
    { "ions": ["Cr2O7^2-", "I-"], "condition": "acidic", "type": "redox", "result": "酸性下 Cr2O7^2- 氧化 I-，不能共存" },
    { "ions": ["ClO-", "I-"], "type": "redox", "result": "ClO- 氧化 I-，不能共存" },
    { "ions": ["ClO-", "S2-"], "type": "redox", "result": "ClO- 氧化 S2-，不能共存" },
    { "ions": ["ClO-", "Fe2+"], "type": "redox", "result": "ClO- 氧化 Fe2+，不能共存" },
    { "ions": ["Fe3+", "Fe"], "type": "redox", "result": "Fe3+ 与 Fe 归中，不能共存" },

    { "ions": ["Fe3+", "SCN-"], "type": "complex", "result": "Fe3+ 与 SCN- 生成血红色络合物，不能共存" },
    { "ions": ["Fe3+", "CN-"], "type": "complex", "result": "Fe3+ 与 CN- 生成络合物，不能共存" },
    { "ions": ["Fe2+", "CN-"], "type": "complex", "result": "Fe2+ 与 CN- 生成络合物，不能共存" },
    { "ions": ["Ag+", "NH3"], "type": "complex", "result": "Ag+ 与 NH3 生成络合物，不能大量共存" },
    { "ions": ["Cu2+", "NH3"], "type": "complex", "result": "Cu2+ 与 NH3 生成络合物，不能大量共存" },
    { "ions": ["Zn2+", "NH3"], "type": "complex", "result": "Zn2+ 与 NH3 生成络合物，不能大量共存" },

    { "ions": ["Al3+", "S2-"], "type": "double_hydrolysis", "result": "Al3+ 与 S2- 双水解，不能共存" },
    { "ions": ["Al3+", "CO3^2-"], "type": "double_hydrolysis", "result": "Al3+ 与 CO3^2- 双水解，不能共存" },
    { "ions": ["Al3+", "HCO3-"], "type": "double_hydrolysis", "result": "Al3+ 与 HCO3- 双水解，不能共存" },
    { "ions": ["Al3+", "[Al(OH)4]^-"], "type": "double_hydrolysis", "result": "Al3+ 与 [Al(OH)4]^- 双水解，不能共存" },
    { "ions": ["Fe3+", "CO3^2-"], "type": "double_hydrolysis", "result": "Fe3+ 与 CO3^2- 双水解，不能共存" },
    { "ions": ["Fe3+", "HCO3-"], "type": "double_hydrolysis", "result": "Fe3+ 与 HCO3- 双水解，不能共存" },
    { "ions": ["Fe3+", "ClO-"], "type": "double_hydrolysis", "result": "Fe3+ 与 ClO- 双水解，不能共存" },
    { "ions": ["NH4+", "[Al(OH)4]^-"], "type": "double_hydrolysis", "result": "NH4+ 与 [Al(OH)4]^- 相互促进水解，不能共存" },
    { "ions": ["HCO3-", "[Al(OH)4]^-"], "type": "double_hydrolysis", "result": "HCO3- 与 [Al(OH)4]^- 反应生成 Al(OH)3，不能共存" },

    { "ions": ["[Cu(NH3)4]^2+", "H+"], "type": "complex_breakdown", "result": "酸性破坏 [Cu(NH3)4]^2+，不能共存" },
    { "ions": ["[Cu(NH3)4]^2+", "Fe3+"], "type": "complex_breakdown", "result": "Fe3+ 与 NH3 结合破坏 [Cu(NH3)4]^2+，不能共存" },
    { "ions": ["[Ag(NH3)2]+", "H+"], "type": "complex_breakdown", "result": "酸性破坏 [Ag(NH3)2]+，不能共存" },
    { "ions": ["[Ag(NH3)2]+", "Br-"], "type": "complex_breakdown", "result": "[Ag(NH3)2]+ 与 Br- 生成 AgBr，不能共存" },
    { "ions": ["[Ag(NH3)2]+", "I-"], "type": "complex_breakdown", "result": "[Ag(NH3)2]+ 与 I- 生成 AgI，不能共存" }
  ]
}
