{
  "version": "1.0",
  "source": "T3 有机化学子集（官能团性质/反应类型/同分异构/同系物/高分子/材料）事实库；人工逐核，以 llmReference 反推真值校验。match 为归一化后必须全部出现在选项中的子串；stemMatch 为必须全部出现在题干中的子串（用于把短选项限定到本题，防跨题误命中）。",
  "statements": [
    { "id": "OF-335-A", "match": ["乙烯", "HCl", "中间体"], "stemMatch": ["烯烃", "加成反应", "机理"], "verdict": true, "reason": "HCl 加成乙烯经碳正离子中间体 CH3CH2+，说法成立。" },
    { "id": "OF-335-B", "match": ["乙烯", "氯水", "CH2ClCH2OH"], "stemMatch": ["烯烃", "加成反应", "机理"], "verdict": false, "reason": "乙烯与氯水反应生成氯乙醇 CH2ClCH2OH，故说无该产物是错的。" },
    { "id": "OF-335-C", "match": ["卤化氢", "HBr", "HCl"], "stemMatch": ["烯烃", "加成反应", "机理"], "verdict": true, "reason": "HBr 键弱于 HCl，与乙烯加成活性 HBr > HCl。" },
    { "id": "OF-335-D", "match": ["甲基", "Br2", "越容易"], "stemMatch": ["烯烃", "加成反应", "机理"], "verdict": true, "reason": "双键碳上甲基给电子，烯烃亲核性增强，与 Br2 加成越容易。" },

    { "id": "OF-366-A", "match": ["葡萄糖", "放热"], "verdict": true, "reason": "葡萄糖氧化生成 CO2 和 H2O 是放热反应。" },
    { "id": "OF-366-B", "match": ["核酸", "磷酸", "戊糖", "碱基"], "verdict": true, "reason": "核酸可看作磷酸、戊糖和碱基结合而成的生物大分子。" },
    { "id": "OF-366-C", "match": ["二肽", "两个氨基", "两个羧基"], "verdict": false, "reason": "甘氨酸形成的二肽仅含 1 个游离氨基和 1 个游离羧基，不是两个。" },
    { "id": "OF-366-D", "match": ["饱和", "NaCl", "鸡蛋清", "盐析"], "verdict": true, "reason": "向饱和 NaCl 溶液加鸡蛋清会发生盐析。" },

    { "id": "OF-369-A", "match": ["苯酚", "甲醛", "酚醛树脂"], "verdict": false, "reason": "线型酚醛树脂每形成一个 CH2 桥脱 1 分子水，n mol 苯酚与 n mol 甲醛生成 (n−1) mol H2O，不是 (2n−1) mol。" },
    { "id": "OF-369-B", "match": ["(NH4)2SO4", "鸡蛋清", "沉淀溶解"], "verdict": true, "reason": "饱和 (NH4)2SO4 使鸡蛋清盐析，加水沉淀溶解，可逆。" },
    { "id": "OF-369-C", "match": ["植物油", "氢化", "硬化油", "肥皂"], "verdict": true, "reason": "植物油氢化得硬化油，不易氧化，可制肥皂。" },
    { "id": "OF-369-D", "match": ["ATP", "磷酸", "核糖", "磷酯键"], "verdict": true, "reason": "ATP 中磷酸与核糖之间通过磷酯键连接。" },

    { "id": "OF-373-A", "match": ["线型聚乙烯", "受热易软化"], "verdict": true, "reason": "线型聚乙烯为热塑性长链高分子，受热易软化。" },
    { "id": "OF-373-B", "match": ["聚四氟乙烯", "受热易分解"], "verdict": false, "reason": "聚四氟乙烯（PTFE）热稳定性极好，不易分解。" },
    { "id": "OF-373-C", "match": ["尼龙66", "己二酸", "己二胺", "缩聚"], "verdict": true, "reason": "尼龙66由己二酸和己二胺缩聚合成。" },
    { "id": "OF-373-D", "match": ["有机玻璃", "甲基丙烯酸酯", "加聚"], "verdict": true, "reason": "有机玻璃由甲基丙烯酸酯加聚合成。" },

    { "id": "OF-374-A", "match": ["C(CH3)=CH"], "stemMatch": ["两种单体", "加聚反应"], "verdict": false, "reason": "该链节来自一种二烯烃单体的加聚，不是两种单体。" },
    { "id": "OF-374-B", "match": ["CH2-CH(CH3)-CH2-CH2"], "stemMatch": ["两种单体", "加聚反应"], "verdict": true, "reason": "链节含 —CH2—CH(CH3)— 与 —CH2—CH2— 两种结构单元，由乙烯与丙烯加聚得到。" },
    { "id": "OF-374-C", "match": ["CH2-CH(C6H5)"], "stemMatch": ["两种单体", "加聚反应"], "verdict": false, "reason": "该链节仅苯乙烯一种单体加聚。" },
    { "id": "OF-374-D", "match": ["NH-CH2-C(O)"], "stemMatch": ["两种单体", "加聚反应"], "verdict": false, "reason": "含酰胺键，为缩聚产物，不是加聚产物。" },

    { "id": "OF-375-A", "match": ["钛合金", "熔点", "纯钛"], "verdict": false, "reason": "钛合金强度高于纯钛，但熔点通常低于纯钛。" },
    { "id": "OF-375-B", "match": ["芳纶纤维", "聚对苯二甲酰对苯二胺", "缩聚"], "verdict": true, "reason": "芳纶纤维由对苯二甲酸与对苯二胺缩聚合成。" },
    { "id": "OF-375-C", "match": ["石英砂", "金刚砂", "同素异形体"], "verdict": false, "reason": "石英砂（SiO2）与金刚砂（SiC）是不同化合物，不互为同素异形体。" },
    { "id": "OF-375-D", "match": ["CO2", "脂肪酸", "有机高分子"], "verdict": false, "reason": "脂肪酸是有机小分子，不是有机高分子。" },

    { "id": "OF-379-A", "match": ["聚对苯二甲酸乙二酯", "PET", "乙二醇", "缩聚"], "verdict": true, "reason": "PET 由对苯二甲酸和乙二醇经缩聚反应制得。" },
    { "id": "OF-379-B", "match": ["酚醛树脂", "单体", "苯酚", "甲醇"], "verdict": false, "reason": "合成酚醛树脂的单体是苯酚和甲醛，不是甲醇。" },
    { "id": "OF-379-C", "match": ["酚醛树脂", "固定的熔"], "verdict": false, "reason": "酚醛树脂是高分子混合物，没有固定的熔、沸点。" },
    { "id": "OF-379-D", "match": ["有机玻璃", "缩聚反应"], "verdict": false, "reason": "有机玻璃由甲基丙烯酸甲酯加聚制得，不是缩聚。" },

    { "id": "OF-385-A", "match": ["乙烯"], "stemMatch": ["所有原子", "共平面"], "verdict": false, "reason": "乙烯为平面分子，所有原子共面，故“不可能共面”不成立。" },
    { "id": "OF-385-B", "match": ["光气"], "stemMatch": ["所有原子", "共平面"], "verdict": false, "reason": "光气（COCl2）为平面三角形，所有原子共面。" },
    { "id": "OF-385-C", "match": ["对二甲苯"], "stemMatch": ["所有原子", "共平面"], "verdict": true, "reason": "对二甲苯含甲基，甲基为四面体结构，其氢原子不可能与苯环共平面。" },
    { "id": "OF-385-D", "match": ["氯苯"], "stemMatch": ["所有原子", "共平面"], "verdict": false, "reason": "氯苯为平面分子，所有原子共面。" },

    { "id": "OF-392-A", "match": ["4种"], "stemMatch": ["C6H12O", "醛类"], "verdict": false, "reason": "C6H12O 醛类为 C5H11—CHO，已知 C5H11 有 8 种，不是 4 种。" },
    { "id": "OF-392-B", "match": ["6种"], "stemMatch": ["C6H12O", "醛类"], "verdict": false, "reason": "应为 8 种，不是 6 种。" },
    { "id": "OF-392-C", "match": ["8种"], "stemMatch": ["C6H12O", "醛类"], "verdict": true, "reason": "C6H12O 醛类即 C5H11—CHO，C5H11 有 8 种，故共 8 种。" },
    { "id": "OF-392-D", "match": ["9种"], "stemMatch": ["C6H12O", "醛类"], "verdict": false, "reason": "应为 8 种，不是 9 种。" },

    { "id": "OF-443-A", "match": ["涤纶", "运动服"], "verdict": true, "reason": "涤纶可作为制作运动服的材料。" },
    { "id": "OF-443-B", "match": ["纤维素", "提供能量"], "verdict": false, "reason": "人体缺乏分解纤维素的酶，纤维素不能被消化吸收提供能量。" },
    { "id": "OF-443-C", "match": ["木糖醇", "甜味剂"], "verdict": true, "reason": "木糖醇可用作运动饮料的甜味剂。" },
    { "id": "OF-443-D", "match": ["氯乙烷", "镇痛"], "verdict": true, "reason": "复方氯乙烷气雾剂可用于运动中急性损伤的镇痛。" },

    { "id": "OF-447-A", "match": ["石墨烯"], "stemMatch": ["属于金属材料"], "verdict": false, "reason": "石墨烯是碳的单质，属于非金属材料。" },
    { "id": "OF-447-B", "match": ["高碳钢"], "stemMatch": ["属于金属材料"], "verdict": true, "reason": "高碳钢是铁碳合金，属于金属材料。" },
    { "id": "OF-447-C", "match": ["芳纶纤维"], "stemMatch": ["属于金属材料"], "verdict": false, "reason": "芳纶纤维是合成纤维，属于非金属材料。" },
    { "id": "OF-447-D", "match": ["高硼玻璃"], "stemMatch": ["属于金属材料"], "verdict": false, "reason": "高硼玻璃是无机非金属材料。" },

    { "id": "OF-448-A", "match": ["青铜", "合金"], "verdict": true, "reason": "青铜是合金。" },
    { "id": "OF-448-B", "match": ["绢", "蚕丝", "天然高分子"], "verdict": true, "reason": "绢是蚕丝织品，属于天然高分子制品。" },
    { "id": "OF-448-C", "match": ["陶瓷", "无机非金属材料"], "verdict": true, "reason": "陶瓷属于无机非金属材料。" },
    { "id": "OF-448-D", "match": ["珐琅彩", "矿物颜料", "有机化合物"], "verdict": false, "reason": "珐琅彩矿物颜料主要为金属氧化物/硅酸盐等无机物，不属于有机化合物。" },

    { "id": "OF-449-A", "match": ["羊毛", "蛋白质"], "verdict": true, "reason": "羊毛主要成分为蛋白质。" },
    { "id": "OF-449-B", "match": ["墨", "单质碳"], "verdict": true, "reason": "墨的主要成分是单质碳。" },
    { "id": "OF-449-C", "match": ["纸", "纤维素"], "verdict": true, "reason": "纸的主要成分是纤维素。" },
    { "id": "OF-449-D", "match": ["大理石", "硅酸盐"], "verdict": false, "reason": "大理石主要成分为碳酸钙（CaCO3），不是硅酸盐。" },

    { "id": "OF-329-A", "match": ["正丁烷和异丁烷", "共价键数目相同"], "stemMatch": ["下列有关有机化合物分子结构和性质的分析中正确的是"], "verdict": true, "reason": "正丁烷与异丁烷互为同分异构体，分子式相同，共价键数均为 13，等物质的量时共价键数目相同。" },
    { "id": "OF-329-B", "match": ["3种不同的烷烃"], "stemMatch": ["下列有关有机化合物分子结构和性质的分析中正确的是"], "verdict": false, "reason": "所列结构中两种为异戊烷（主链 4 碳）、一种为正戊烷，实际代表 2 种不同烷烃，不是 3 种。" },
    { "id": "OF-329-C", "match": ["耗O2量", "CH4>C2H6>C3H8"], "stemMatch": ["下列有关有机化合物分子结构和性质的分析中正确的是"], "verdict": true, "reason": "等质量烷烃完全燃烧，H/C 比越高耗氧越多；CH4(4) > C2H6(3) > C3H8(≈2.7)，故耗氧量 CH4>C2H6>C3H8。" },
    { "id": "OF-329-D", "match": ["生成CCl4", "2 mol Cl2"], "stemMatch": ["下列有关有机化合物分子结构和性质的分析中正确的是"], "verdict": false, "reason": "甲烷取代为“断一换一”，1 mol CH4 完全生成 CCl4 需取代 4 个 H，最多消耗 4 mol Cl2，不是 2 mol。" },
    { "id": "OF-329-E", "match": ["沸点", "正戊烷>异戊烷>新戊烷"], "stemMatch": ["下列有关有机化合物分子结构和性质的分析中正确的是"], "verdict": true, "reason": "烷烃沸点随相对分子质量增大而升高，同分异构体支链越多沸点越低，故 正戊烷>异戊烷>新戊烷>丙烷。" },

    { "id": "OF-360-A", "match": ["酸性高锰酸钾溶液褪色"], "stemMatch": ["海南暗罗"], "verdict": true, "reason": "该分子含碳碳双键、醛基等还原性基团，能使酸性高锰酸钾溶液褪色。" },
    { "id": "OF-360-B", "match": ["分子式为C19H28O4"], "stemMatch": ["海南暗罗"], "verdict": false, "reason": "由结构简式计算不饱和度为 7（2 环 + 5 双键），而 C19H28O4 不饱和度为 6，矛盾，故分子式不是 C19H28O4。" },
    { "id": "OF-360-C", "match": ["4个手性碳原子"], "stemMatch": ["海南暗罗"], "verdict": true, "reason": "连有 4 个不同原子或基团的碳原子为手性碳，该分子结构中标 * 处共有 4 个手性碳原子。" },
    { "id": "OF-360-D", "match": ["S环己烷", "S乙醇"], "stemMatch": ["海南暗罗"], "verdict": false, "reason": "该化合物为极性分子，能与乙醇形成氢键，在乙醇中溶解度大于环己烷，故 S环己烷＞S乙醇 错误。" },
    {"id": "OF-361-A", "match": ["CH3CH2Br属于烃类"], "stemMatch": ["按碳的骨架对有机化合物进行分类"], "verdict": false, "reason": "CH3CH2Br含Br,是烃的衍生物,不属于烃类。"},
    {"id": "OF-361-B", "match": ["CH(CH3)3属于烃的衍生物"], "stemMatch": ["按碳的骨架对有机化合物进行分类"], "verdict": false, "reason": "CH(CH3)3即C4H10只含C、H,属于烃,不是衍生物。"},
    {"id": "OF-361-C", "match": ["环己烯属于脂肪烃"], "stemMatch": ["按碳的骨架对有机化合物进行分类"], "verdict": false, "reason": "环己烯含碳环,属脂环烃;脂肪烃指链状烃。"},
    {"id": "OF-361-D", "match": ["苯酚属于芳香族化合物"], "stemMatch": ["按碳的骨架对有机化合物进行分类"], "verdict": true, "reason": "苯酚含苯环,属于芳香族化合物。"}
  ]
}
