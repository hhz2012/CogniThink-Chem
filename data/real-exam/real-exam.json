    {
      "id": "IDENT-RE1",
      "category": "SubstanceIdentification",
      "difficulty": "Hard",
      "problemText": "（2022·全国乙卷 第3题改编）某白色粉末样品可能含有 Na2S2O3、Na2SO3、Na2CO3、Na2SO4 中的一种或几种。取少量样品：①溶于水，得到无色透明溶液；②向①的溶液中滴加过量稀盐酸，溶液变浑浊，有刺激性气体逸出；③取②的上层清液，滴加 BaCl2 溶液，有沉淀生成。判断样品中一定存在与不能确定的成分。",
      "given": {
        "candidateSpecies": ["S2O3^2-", "SO3^2-", "CO3^2-", "SO4^2-"],
        "steps": [
          { "step": 1, "from": "无色透明溶液", "to": "浑浊+刺激性气体", "reagents": ["HCl"], "phenomenon": "滴加过量稀盐酸，溶液变浑浊，有刺激性气体逸出" },
          { "step": 2, "from": "上层清液", "to": "白色沉淀", "reagents": ["BaCl2"], "phenomenon": "滴加 BaCl2 溶液，有沉淀生成" }
        ]
      },
      "question": { "ask": "IdentifySubstances", "targets": ["一定存在的成分", "不能确定的成分"] },
      "expected": {
        "composition": { "S2O3^2-": "Must", "SO4^2-": "Must", "SO3^2-": "Maybe", "CO3^2-": "Maybe" },
        "equations": ["S2O3^2- + 2H^+ = S↓ + SO2↑ + H2O", "Ba^2+ + SO4^2- = BaSO4↓"],
        "engineExpectation": { "isValid": true, "mustPass": ["白名单校验", "元素与电荷守恒", "配平", "状态符号"] }
      },
      "source": "2022年普通高等学校招生全国统一考试（全国乙卷）化学 第3题",
      "tags": ["高考真题", "成分推断", "硫及其化合物", "实验探究"]
    },
    {
      "id": "PROC-RE1",
      "category": "ProcessInference",
      "difficulty": "Medium",
      "problemText": "A 是目前使用量最大的金属。A 在 Cl2 中燃烧生成 B；向 B 的溶液中加入 A 得到 C；向 C 的溶液中通入 Cl2 又得到 B。确定 A、B、C 并写出各步反应的化学方程式。",
      "given": {
        "candidateSpecies": ["Fe", "FeCl2", "FeCl3", "Cl2"],
        "steps": [
          { "step": 1, "from": "A", "to": "B", "reagents": ["Cl2"], "conditions": ["点燃"], "phenomenon": "产生棕褐色烟" },
          { "step": 2, "from": "B", "to": "C", "reagents": ["Fe"], "phenomenon": "溶液由黄色变浅绿色" },
          { "step": 3, "from": "C", "to": "B", "reagents": ["Cl2"], "phenomenon": "溶液由浅绿色变黄色" }
        ]
      },
      "question": { "ask": "WriteStepEquations", "targets": ["A", "B", "C", "各步方程式"] },
      "expected": {
        "substanceMap": { "A": "Fe", "B": "FeCl3", "C": "FeCl2" },
        "equations": [
          "2Fe + 3Cl2 =点燃= 2FeCl3",
          "Fe + 2FeCl3 = 3FeCl2",
          "2FeCl2 + Cl2 = 2FeCl3"
        ],
        "engineExpectation": { "isValid": true, "mustPass": ["白名单校验", "元素与电荷守恒", "配平"] }
      },
      "source": "高考真题（铁及其化合物转化，Fe/Fe^2+/Fe^3+ 三角关系）",
      "tags": ["高考真题", "过程推断", "铁及其化合物"]
    },
    {
      "id": "CALC-RE1",
      "category": "StoichiometryCalc",
      "difficulty": "Medium",
      "problemText": "（2023·全国新课标卷 实验题改编）由安息香（C14H12O2，M=212 g/mol）氧化制二苯乙二酮（M=210 g/mol）。实验中 2.0 g 安息香完全反应理论上可制得 1.98 g 二苯乙二酮，实际得到产物 1.6 g。计算本实验的产率（用小数表示）。",
      "given": {
        "numericFacts": [
          { "kind": "Mass", "species": "C14H12O2", "value": "2.0", "unit": "g" },
          { "kind": "Mass", "species": "二苯乙二酮", "value": "1.98", "unit": "g" },
          { "kind": "ActualYieldMass", "species": "二苯乙二酮", "value": "1.6", "unit": "g" }
        ]
      },
      "question": { "ask": "Calculate", "targets": ["产率"] },
      "expected": {
        "calc": { "op": "YieldRatio", "actualMassGrams": "1.6", "theoreticalMassGrams": "1.98" },
        "numericAnswer": { "value": "80/99", "unit": "比率", "species": "二苯乙二酮" },
        "equations": [],
        "engineExpectation": { "isValid": true, "mustPass": [] }
      },
      "source": "2023年普通高等学校招生全国统一考试（新课标卷）化学 实验题（产率计算）",
      "tags": ["高考真题", "定量计算", "产率", "实验"]
    },
