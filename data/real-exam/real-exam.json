      "question": { "ask": "JudgeCoexistence", "targets": ["共存判断", "理由方程式"] },
      "expected": {
        "verdict": "NotCoexist",
        "equations": ["6I^- + 2NO3^- + 8H^+ = 3I2 + 2NO↑ + 4H2O"],
        "engineExpectation": { "isValid": true, "mustPass": ["白名单校验", "元素与电荷守恒", "配平", "状态符号"] }
