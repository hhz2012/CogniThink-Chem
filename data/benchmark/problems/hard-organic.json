    {
      "id": "ORG-H01",
      "category": "OrganicInference",
      "difficulty": "Hard",
      "problemText": "A 是植物生长调节剂（果实催熟剂）。A 与水在催化剂、加热、加压条件下反应生成 B；B 在 Cu 作催化剂并加热时发生催化氧化生成 C；C 继续与氧气在催化剂、加热条件下反应生成 D；D 与 B 在浓硫酸、加热条件下反应，液面上方出现有香味的无色油状液体 E。确定 A～E 并写出各步反应的化学方程式。",
      "given": {
        "candidateSpecies": ["C2H4", "C2H5OH", "CH3CHO", "CH3COOH", "CH3COOCH2CH3"],
        "steps": [
          { "step": 1, "from": "A", "to": "B", "reagents": ["H2O"], "conditions": ["催化剂", "△", "加压"] },
          { "step": 2, "from": "B", "to": "C", "reagents": ["O2"], "conditions": ["Cu", "△"] },
          { "step": 3, "from": "C", "to": "D", "reagents": ["O2"], "conditions": ["催化剂", "△"] },
          { "step": 4, "from": "D", "to": "E", "reagents": ["B"], "conditions": ["浓H2SO4", "△"], "phenomenon": "液面上方出现有香味的无色油状液体" }
        ]
      },
      "question": { "ask": "InferOrganicChain", "targets": ["A", "B", "C", "D", "E", "各步方程式"] },
      "expected": {
        "substanceMap": { "A": "C2H4", "B": "C2H5OH", "C": "CH3CHO", "D": "CH3COOH", "E": "CH3COOCH2CH3" },
        "equations": [
          "C2H4 + H2O =催化剂,△,加压= C2H5OH",
          "2C2H5OH + O2 =Cu,△= 2CH3CHO + 2H2O",
          "2CH3CHO + O2 =催化剂,△= 2CH3COOH",
          "CH3COOH + C2H5OH ⇌ CH3COOCH2CH3 + H2O"
        ],
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平"]
        }
      },
      "distractors": [
        {
          "id": "ORG-H01-D1",
          "description": "乙醇催化氧化未配平：氧原子不守恒",
          "equation": "C2H5OH + O2 =Cu,△= CH3CHO + H2O",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        },
        {
          "id": "ORG-H01-D2",
          "description": "酯化反应漏写产物水",
          "equation": "CH3COOH + C2H5OH = CH3COOCH2CH3",
          "expectValid": false,
          "expectFailChecks": ["元素守恒", "反应库一致性"]
        }
      ],
      "source": "人教版《化学·必修第二册》第七章'有机化合物'、《选择性必修3·有机化学基础》第三章'烃的衍生物'（乙烯—乙醇—乙醛—乙酸—酯转化链，高考有机推断典型题型）",
      "tags": ["有机推断", "转化链", "乙醇乙酸"]
    },
    {
      "id": "ORG-H02",
      "category": "OrganicInference",
      "difficulty": "Hard",
      "problemText": "A 是葡萄糖，在催化剂作用下发酵生成 B 和二氧化碳；B 经铜催化氧化（加热）生成 C；C 与银氨溶液在水浴加热条件下反应，试管内壁形成光亮的银镜，生成 D。确定 A～D 并写出各步反应的化学方程式。",
      "given": {
        "candidateSpecies": ["C6H12O6", "C2H5OH", "CH3CHO", "CH3COONH4", "CH3COOH"],
        "steps": [
          { "step": 1, "from": "A", "to": "B", "conditions": ["催化剂"] },
          { "step": 2, "from": "B", "to": "C", "reagents": ["O2"], "conditions": ["Cu", "△"] },
          { "step": 3, "from": "C", "to": "D", "reagents": ["Ag(NH3)2OH"], "conditions": ["水浴", "△"], "phenomenon": "试管内壁形成光亮的银镜" }
        ]
      },
      "question": { "ask": "InferOrganicChain", "targets": ["A", "B", "C", "D", "各步方程式"] },
      "expected": {
        "substanceMap": { "A": "C6H12O6", "B": "C2H5OH", "C": "CH3CHO", "D": "CH3COONH4" },
        "equations": [
          "C6H12O6 =催化剂= 2C2H5OH + 2CO2↑",
          "2C2H5OH + O2 =Cu,△= 2CH3CHO + 2H2O",
          "CH3CHO + 2Ag(NH3)2OH =水浴,△= CH3COONH4 + 2Ag↓ + 3NH3 + H2O"
        ],
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平"]
        }
      },
      "distractors": [
        {
          "id": "ORG-H02-D1",
          "description": "葡萄糖发酵未配平：碳、氢、氧均不守恒",
          "equation": "C6H12O6 =催化剂= C2H5OH + CO2",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "source": "人教版《化学·必修第二册》第七章'有机化合物'、《选择性必修3·有机化学基础》第三章'烃的衍生物'（葡萄糖发酵与银镜反应，高考有机推断典型题型）",
      "tags": ["有机推断", "转化链", "糖类银镜反应"]
    },
    {
      "id": "ORG-H03",
      "category": "OrganicInference",
      "difficulty": "Hard",
      "problemText": "A 是常见的液态烃，不能使溴水因反应褪色。A 与液溴在 FeBr3 催化下反应生成 B，导管口出现白雾；A 与浓硝酸在浓硫酸催化、水浴加热下反应生成 C；A 与氢气在 Ni 催化、加热下加成生成 D。确定 A～D 并写出各步反应的化学方程式。",
      "given": {
        "candidateSpecies": ["C6H6", "C6H5Br", "C6H5NO2", "C6H12"],
        "steps": [
          { "step": 1, "from": "A", "to": "B", "reagents": ["Br2"], "conditions": ["FeBr3"], "phenomenon": "导管口出现白雾" },
          { "step": 2, "from": "A", "to": "C", "reagents": ["HNO3"], "conditions": ["浓H2SO4", "水浴", "△"] },
          { "step": 3, "from": "A", "to": "D", "reagents": ["H2"], "conditions": ["Ni", "△"] }
        ]
      },
      "question": { "ask": "InferOrganicChain", "targets": ["A", "B", "C", "D", "各步方程式"] },
      "expected": {
        "substanceMap": { "A": "C6H6", "B": "C6H5Br", "C": "C6H5NO2", "D": "C6H12" },
        "equations": [
          "C6H6 + Br2 =FeBr3= C6H5Br + HBr",
          "C6H6 + HNO3 =浓H2SO4,水浴,△= C6H5NO2 + H2O",
          "C6H6 + 3H2 =Ni,△= C6H12"
        ],
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平"]
        }
      },
      "distractors": [
        {
          "id": "ORG-H03-D1",
          "description": "苯的溴代漏写产物溴化氢：氢、溴不守恒",
          "equation": "C6H6 + Br2 =FeBr3= C6H5Br",
          "expectValid": false,
          "expectFailChecks": ["元素守恒", "反应库一致性"]
        }
      ],
      "source": "人教版《选择性必修3·有机化学基础》第二章'烃'（苯的溴代、硝化与加氢，高考有机推断典型题型）",
      "tags": ["有机推断", "苯的性质", "取代反应"]
    },
    {
      "id": "ORG-H04",
      "category": "OrganicInference",
      "difficulty": "Hard",
      "problemText": "A 是卤代烃。A 与 NaOH 的水溶液共热生成 B；A 与 NaOH 的醇溶液共热发生消去反应，产生使溴水褪色的气体 C；C 与溴水反应生成 D；C 与氢气在 Ni 催化、加热下加成生成 E。确定 A～E 并写出各步反应的化学方程式。",
      "given": {
        "candidateSpecies": ["C2H5Br", "C2H5OH", "C2H4", "C2H4Br2", "C2H6"],
        "steps": [
          { "step": 1, "from": "A", "to": "B", "reagents": ["NaOH"], "conditions": ["水溶液", "△"] },
          { "step": 2, "from": "A", "to": "C", "reagents": ["NaOH"], "conditions": ["醇溶液", "△"], "phenomenon": "产生使溴水褪色的气体" },
          { "step": 3, "from": "C", "to": "D", "reagents": ["Br2"] },
          { "step": 4, "from": "C", "to": "E", "reagents": ["H2"], "conditions": ["Ni", "△"] }
        ]
      },
      "question": { "ask": "InferOrganicChain", "targets": ["A", "B", "C", "D", "E", "各步方程式"] },
      "expected": {
        "substanceMap": { "A": "C2H5Br", "B": "C2H5OH", "C": "C2H4", "D": "C2H4Br2", "E": "C2H6" },
        "equations": [
          "C2H5Br + NaOH =水溶液,△= C2H5OH + NaBr",
          "C2H5Br + NaOH =醇溶液,△= C2H4↑ + NaBr + H2O",
          "C2H4 + Br2 = C2H4Br2",
          "C2H4 + H2 =Ni,△= C2H6"
