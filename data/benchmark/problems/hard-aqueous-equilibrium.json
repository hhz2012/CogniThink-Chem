        }
      },
      "question": { "ask": "CompareConcentrations", "targets": ["三大守恒", "粒子浓度排序"] },
      "expected": {
        "equations": ["NH4^+ + H2O ⇌ NH3·H2O + H^+", "H2O ⇌ H^+ + OH^-"],
        "aqueous": {
