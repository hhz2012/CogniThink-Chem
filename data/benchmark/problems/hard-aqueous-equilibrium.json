    {
      "id": "AQ-H05",
      "category": "AqueousIonEquilibrium",
      "difficulty": "Hard",
      "source": "人教版《化学·选择性必修1》第三章'水溶液中的离子反应与平衡'",
      "problemText": "浓度均为 0.1 mol/L 的 CH3COOH 与 CH3COONa 溶液等体积混合，比较电离程度（Ka）与水解程度（Kh = Kw/Ka）判断酸碱性，写出电荷守恒与物料守恒，并将 c(CH3COO^-)、c(Na^+)、c(CH3COOH)、c(H^+)、c(OH^-) 按由大到小排序。",
      "given": {
        "solution": {
          "solutes": [
            { "species": "CH3COOH", "concentration": "0.1", "volumeLiters": "1" },
            { "species": "CH3COONa", "concentration": "0.1", "volumeLiters": "1" }
          ],
          "orderSpecies": ["CH3COO^-", "Na^+", "CH3COOH", "H^+", "OH^-"]
        }
      },
      "question": { "ask": "CompareConcentrations", "targets": ["缓冲体系", "电离与水解竞争", "粒子浓度排序"] },
      "expected": {
        "equations": ["CH3COOH ⇌ CH3COO^- + H^+", "CH3COO^- + H2O ⇌ CH3COOH + OH^-", "H2O ⇌ H^+ + OH^-"],
        "aqueous": {
          "order": ["c(CH3COO^-)", "c(Na^+)", "c(CH3COOH)", "c(H^+)", "c(OH^-)"],
          "conservationEquations": [
            "c(Na^+) + c(H^+) = c(CH3COO^-) + c(OH^-)",
            "[c(CH3COOH) + c(CH3COO^-)] = 2c(Na^+)"
          ]
        }
      },
      "distractors": [
        {
          "id": "AQ-H05-D1",
          "description": "把缓冲体系中醋酸根的水解式多写一个 H^+ 在右侧，元素与电荷均不守恒",
          "equation": "CH3COO^- + H2O ⇌ CH3COOH + OH^- + H^+",
          "expectValid": false,
          "expectFailChecks": ["元素守恒", "电荷守恒"]
        }
      ],
      "tags": ["缓冲溶液", "电离大于水解", "物料守恒"]
    },
    {
      "id": "AQ-H06",
      "category": "AqueousIonEquilibrium",
      "difficulty": "Hard",
      "source": "人教版《化学·选择性必修1》第三章'水溶液中的离子反应与平衡'",
      "problemText": "用 0.1 mol/L NaOH 溶液滴定 20 mL 0.1 mol/L CH3COOH 溶液，当滴至 pH = 7（中性）时停止。写出此时溶液的电荷守恒表达式，并比较 c(Na^+)、c(CH3COO^-)、c(H^+)、c(OH^-) 的大小关系。",
      "given": {
        "solution": {
          "solutes": [
            { "species": "CH3COOH", "concentration": "0.1", "volumeLiters": "0.02" },
            { "species": "NaOH", "concentration": "0.1", "volumeLiters": "0.02" }
          ],
          "ph": "7",
          "note": "滴至 pH = 7 时停止（NaOH 实际用量略少于 20 mL，题给中性结论为准）",
          "orderSpecies": ["Na^+", "CH3COO^-", "H^+", "OH^-"]
        }
      },
      "question": { "ask": "CompareConcentrations", "targets": ["滴定终点判断", "电荷守恒"] },
      "expected": {
        "equations": ["CH3COOH ⇌ CH3COO^- + H^+", "H2O ⇌ H^+ + OH^-"],
        "aqueous": {
          "order": ["c(Na^+) = c(CH3COO^-)", "c(H^+) = c(OH^-)"],
          "conservationEquations": [
            "c(Na^+) + c(H^+) = c(CH3COO^-) + c(OH^-)"
          ]
        }
      },
      "distractors": [
        {
          "id": "AQ-H06-D1",
          "description": "误认为中性时醋酸根水解式右侧还有多余 H^+，元素与电荷均不守恒",
          "equation": "CH3COO^- + H2O ⇌ CH3COOH + OH^- + H^+",
          "expectValid": false,
          "expectFailChecks": ["元素守恒", "电荷守恒"]
        }
      ],
      "tags": ["酸碱中和滴定", "电荷守恒", "中性判据"]
    },
