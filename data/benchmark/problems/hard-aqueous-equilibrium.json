  "items": [
    {
      "id": "AQ-H01",
      "category": "AqueousIonEquilibrium",
      "difficulty": "Hard",
      "source": "人教版《化学·选择性必修1》第三章'水溶液中的离子反应与平衡'",
      "problemText": "0.1 mol/L CH3COONa 溶液中，写出电荷守恒、物料守恒与质子守恒表达式，并将 c(Na^+)、c(CH3COO^-)、c(OH^-)、c(H^+) 按由大到小排序。",
      "given": {
        "solution": {
          "solutes": [
            { "species": "CH3COONa", "concentration": "0.1", "volumeLiters": "1" }
          ],
          "orderSpecies": ["Na^+", "CH3COO^-", "OH^-", "H^+"]
        }
      },
      "question": { "ask": "CompareConcentrations", "targets": ["三大守恒", "粒子浓度排序"] },
      "expected": {
        "equations": ["CH3COO^- + H2O ⇌ CH3COOH + OH^-", "H2O ⇌ H^+ + OH^-"],
        "aqueous": {
          "order": ["c(Na^+)", "c(CH3COO^-)", "c(OH^-)", "c(H^+)"],
          "conservationEquations": [
            "c(Na^+) + c(H^+) = c(CH3COO^-) + c(OH^-)",
            "c(Na^+) = c(CH3COOH) + c(CH3COO^-)",
            "c(OH^-) = c(H^+) + c(CH3COOH)"
          ]
        }
      },
      "distractors": [
        {
          "id": "AQ-H01-D1",
          "description": "把水解与电离混写成一个式子，在醋酸电离式右边多写 OH^-，元素与电荷均不守恒",
          "equation": "CH3COOH ⇌ CH3COO^- + H^+ + OH^-",
          "expectValid": false,
          "expectFailChecks": ["元素守恒", "电荷守恒"]
        }
      ],
      "tags": ["盐类水解", "三大守恒", "强碱弱酸盐"]
    },
    {
