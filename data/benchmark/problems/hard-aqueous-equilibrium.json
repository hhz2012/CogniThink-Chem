      "source": "人教版《化学·选择性必修1》第三章'水溶液中的离子反应与平衡'",
      "problemText": "0.1 mol/L Na2CO3 溶液中，写出电荷守恒、物料守恒与质子守恒表达式，并将 c(Na^+)、c(CO3^2-)、c(OH^-)、c(HCO3^-)、c(H^+) 按由大到小排序。",
      "given": {
        "solution": {
          "solutes": [
            { "species": "Na2CO3", "concentration": "0.1", "volumeLiters": "1" }
          ],
          "orderSpecies": ["Na^+", "CO3^2-", "OH^-", "HCO3^-", "H^+"]
        }
      },
      "question": { "ask": "CompareConcentrations", "targets": ["三大守恒", "分步水解", "粒子浓度排序"] },
      "expected": {
        "equations": ["CO3^2- + H2O ⇌ HCO3^- + OH^-", "HCO3^- + H2O ⇌ H2CO3 + OH^-", "H2O ⇌ H^+ + OH^-"],
        "aqueous": {
          "order": ["c(Na^+)", "c(CO3^2-)", "c(OH^-)", "c(HCO3^-)", "c(H^+)"],
          "conservationEquations": [
            "c(Na^+) + c(H^+) = 2c(CO3^2-) + c(HCO3^-) + c(OH^-)",
            "c(Na^+) = 2[c(H2CO3) + c(HCO3^-) + c(CO3^2-)]",
            "c(OH^-) = c(H^+) + c(HCO3^-) + 2c(H2CO3)"
          ]
        }
      },
      "distractors": [
        {
          "id": "AQ-H03-D1",
          "description": "多元弱酸根水解跳步：把 CO3^2- 一步写成直接生成 H2CO3，元素与电荷均不守恒",
          "equation": "CO3^2- + H2O ⇌ H2CO3 + OH^-",
          "expectValid": false,
          "expectFailChecks": ["元素守恒", "电荷守恒"]
        }
      ],
      "tags": ["多元弱酸盐", "分步水解", "质子守恒"]
    },
