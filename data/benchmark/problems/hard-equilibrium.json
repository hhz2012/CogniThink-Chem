          "initial": { "SO2": "2", "O2": "1" },
          "known": { "kind": "amountFraction", "species": "SO2", "value": "1/3" },
          "totalPressure": "1",
          "fractionSpecies": "SO3"
        }
      },
      "question": { "ask": "EquilibriumCalculation", "targets": ["三段式", "SO2 转化率", "SO3 摩尔分数", "Kp"] },
      "expected": {
        "equations": ["2SO2 + O2 ⇌ 2SO3"],
        "equilibrium": {
          "table": [
            { "species": "SO2", "start": "2", "change": "-6/5", "end": "4/5" },
            { "species": "O2", "start": "1", "change": "-3/5", "end": "2/5" },
            { "species": "SO3", "start": "0", "change": "6/5", "end": "6/5" }
          ],
          "conversionSpecies": "SO2",
          "conversion": "3/5",
