    {
      "id": "EQ-H01",
      "category": "ChemicalEquilibrium",
      "difficulty": "Hard",
      "problemText": "恒温恒容密闭容器中发生可逆反应 N2 + 3H2 ⇌ 2NH3。起始充入 1 mol N2 和 3 mol H2，平衡时 N2 的转化率为 1/3，体系总压为 10 atm。列出三段式求平衡组成，并计算 NH3 的摩尔分数与 Kp（分压 = 摩尔分数 × 总压，Kp = 生成物分压计量数次幂之积 / 反应物分压计量数次幂之积）。",
      "given": {
        "equilibrium": {
          "equation": "N2 + 3H2 ⇌ 2NH3",
          "container": "constantVolume",
          "initial": { "N2": "1", "H2": "3" },
          "known": { "kind": "conversion", "species": "N2", "value": "1/3" },
          "totalPressure": "10",
          "fractionSpecies": "NH3"
        }
      },
      "question": { "ask": "EquilibriumCalculation", "targets": ["三段式", "N2 转化率", "NH3 摩尔分数", "Kp"] },
      "expected": {
        "equations": ["N2 + 3H2 ⇌ 2NH3"],
        "equilibrium": {
          "table": [
            { "species": "N2", "start": "1", "change": "-1/3", "end": "2/3" },
            { "species": "H2", "start": "3", "change": "-1", "end": "2" },
            { "species": "NH3", "start": "0", "change": "2/3", "end": "2/3" }
          ],
          "conversionSpecies": "N2",
          "conversion": "1/3",
          "fractionSpecies": "NH3",
          "fraction": "1/5",
          "kValue": "1/108",
          "direction": null
        }
      },
      "distractors": [
        {
          "id": "EQ-H01-D1",
          "description": "方程式未配平即列三段式：把计量数当作分子式角标（H2 系数漏乘），元素不守恒，转化量与平衡量随之全错",
          "equation": "N2 + H2 ⇌ 2NH3",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "source": "人教版《化学·选择性必修1》第二章'化学反应速率与化学平衡'",
      "tags": ["化学平衡", "三段式", "转化率", "Kp", "合成氨"]
    },
    {
