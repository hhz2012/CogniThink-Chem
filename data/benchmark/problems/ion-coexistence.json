  "version": "1.0",
  "items": [
    {
      "id": "COEX-001",
      "category": "IonCoexistence",
      "difficulty": "Basic",
      "problemText": "在酸性溶液中，K^+、Na^+、SO4^2-、CO3^2- 能否大量共存？若能，说明理由；若不能，写出相关反应的离子方程式。",
      "given": { "species": ["K^+", "Na^+", "SO4^2-", "CO3^2-"], "medium": "acidic" },
      "question": { "ask": "JudgeCoexistence", "targets": ["共存判断", "理由方程式"] },
      "expected": {
        "equations": ["CO3^2- + 2H^+ = H2O + CO2↑"],
        "verdict": "NotCoexist",
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平", "状态符号"]
        }
      },
      "distractors": [
        {
          "id": "COEX-001-D1",
          "description": "电荷不守恒：左边净电荷 -1，右边 0",
          "equation": "CO3^2- + H^+ = H2O + CO2↑",
          "expectValid": false,
          "expectFailChecks": ["电荷守恒"]
        }
      ],
      "source": "人教版《化学·必修第一册》第二章'离子反应'（离子共存）",
      "tags": ["离子共存", "酸性介质", "弱酸根"]
    },
    {
      "id": "COEX-002",
