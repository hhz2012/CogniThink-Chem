    {
      "id": "IONP-H01",
      "category": "IonPowderIdentification",
      "difficulty": "Hard",
      "problemText": "某溶液可能含有 Na^+、K^+、NH4^+、CO3^2-、SO4^2- 中的一种或几种。进行如下实验：①取原溶液做焰色试验，透过蓝色钴玻璃观察到紫色火焰；②另取原溶液加入足量 NaOH 溶液并加热，产生使湿润红色石蕊试纸变蓝的气体；③另取原溶液滴加足量 BaCl2 溶液和稀硝酸，产生白色沉淀，沉淀不溶解。判断溶液中一定存在、一定不存在与不能确定的离子。",
      "given": {
        "candidateSpecies": ["Na^+", "K^+", "NH4^+", "CO3^2-", "SO4^2-"],
        "steps": [
          { "step": 1, "from": "溶液", "to": "紫色火焰", "reagents": ["焰色试验", "蓝色钴玻璃"], "phenomenon": "透过蓝色钴玻璃焰色试验，观察到紫色火焰" },
          { "step": 2, "from": "溶液", "to": "碱性气体", "reagents": ["NaOH"], "conditions": ["△"], "phenomenon": "加足量 NaOH 溶液并加热，产生使湿润红色石蕊试纸变蓝的气体" },
          { "step": 3, "from": "溶液", "to": "白色沉淀不溶", "reagents": ["BaCl2", "HNO3"], "phenomenon": "滴加足量 BaCl2 溶液和稀硝酸，产生白色沉淀，沉淀不溶解" }
        ]
      },
      "question": { "ask": "IdentifyIonPowder", "targets": ["一定存在的离子", "一定不存在的离子", "不能确定的离子"] },
      "expected": {
        "equations": [
          "Ba^2+ + SO4^2- = BaSO4↓",
          "NH4^+ + OH^- =△= NH3↑ + H2O"
        ],
        "composition": { "Na^+": "Maybe", "K^+": "Must", "NH4^+": "Must", "CO3^2-": "Maybe", "SO4^2-": "Must" },
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平", "状态符号"]
        }
      },
      "distractors": [
        {
          "id": "IONP-H01-D1",
          "description": "BaSO4 难溶，漏标 ↓",
          "equation": "Ba^2+ + SO4^2- = BaSO4",
          "expectValid": false,
          "expectFailChecks": ["状态符号"]
        },
        {
          "id": "IONP-H01-D2",
          "description": "配平错误：氢原子不守恒（左边 9 个 H，右边 8 个 H）",
          "equation": "2NH4^+ + OH^- =△= 2NH3↑ + H2O",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "source": "人教版《化学·必修第一册》第一章'物质及其变化'（离子检验）与第二章'钠及其化合物'（焰色试验）",
      "tags": ["离子粉末推断", "溶液连续操作", "焰色反应", "铵根检验", "必要性判定"]
    },
