      "id": "IONP-H02",
      "category": "IonPowderIdentification",
      "difficulty": "Hard",
      "problemText": "某溶液可能含有 NH4^+、K^+、CO3^2-、SO4^2-、Cl^- 中的一种或几种。进行如下实验：①加入足量稀硝酸，产生气体；②向①所得溶液中加入 Ba(NO3)2 溶液，无明显沉淀；③向②所得溶液中加入 AgNO3 溶液和稀硝酸，产生白色沉淀；④另取原溶液加入足量 NaOH 溶液并加热，无明显现象；⑤取原溶液做焰色试验，透过蓝色钴玻璃观察到紫色火焰。判断溶液中一定存在、一定不存在与不能确定的离子。",
      "given": {
        "candidateSpecies": ["NH4^+", "K^+", "CO3^2-", "SO4^2-", "Cl^-"],
        "steps": [
          { "step": 1, "from": "溶液", "to": "气体", "reagents": ["HNO3"], "phenomenon": "加入足量稀硝酸，产生气体" },
          { "step": 2, "from": "①所得溶液", "to": "无沉淀", "reagents": ["Ba(NO3)2"], "phenomenon": "无明显沉淀" },
          { "step": 3, "from": "②所得溶液", "to": "白色沉淀", "reagents": ["AgNO3", "HNO3"], "phenomenon": "产生白色沉淀（不溶于稀硝酸）" },
          { "step": 4, "from": "溶液", "to": "无现象", "reagents": ["NaOH"], "conditions": ["△"], "phenomenon": "加足量 NaOH 溶液并加热，无明显现象" },
          { "step": 5, "from": "溶液", "to": "紫色火焰", "reagents": ["焰色试验", "蓝色钴玻璃"], "phenomenon": "透过蓝色钴玻璃焰色试验，观察到紫色火焰" }
        ]
      },
      "question": { "ask": "IdentifyIonPowder", "targets": ["一定存在的离子", "一定不存在的离子", "不能确定的离子"] },
      "expected": {
        "equations": [
          "CO3^2- + 2H^+ = H2O + CO2↑",
          "Ag^+ + Cl^- = AgCl↓"
        ],
        "composition": { "NH4^+": "MustNot", "K^+": "Must", "CO3^2-": "Must", "SO4^2-": "MustNot", "Cl^-": "Must" },
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平", "状态符号"]
        }
      },
      "distractors": [
        {
          "id": "IONP-H02-D1",
          "description": "电荷不守恒：左边净电荷 -1，右边 0",
          "equation": "CO3^2- + H^+ = H2O + CO2↑",
          "expectValid": false,
          "expectFailChecks": ["电荷守恒"]
        },
        {
          "id": "IONP-H02-D2",
          "description": "AgCl 难溶，漏标 ↓",
          "equation": "Ag^+ + Cl^- = AgCl",
          "expectValid": false,
          "expectFailChecks": ["状态符号"]
        }
      ],
      "source": "人教版《化学·必修第一册》第一章'物质及其变化'（离子检验综合）；《必修第二册》第五章'氮及其化合物'（铵根检验）",
      "tags": ["离子粉末推断", "溶液连续操作", "负证据排除", "焰色反应"]
    },
