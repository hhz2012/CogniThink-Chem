          { "step": 4, "from": "②所得滤液", "to": "白色沉淀不溶", "reagents": ["AgNO3", "HNO3"], "phenomenon": "加入 AgNO3 溶液和稀硝酸，产生白色沉淀，沉淀不溶解" }
