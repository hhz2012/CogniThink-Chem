    {
      "id": "PROCF-H07",
      "category": "IndustrialProcess",
      "difficulty": "Hard",
      "source": "人教版《化学·必修第二册》第六章'化工生产中的重要非金属元素'硅与硅酸盐",
      "problemText": "以硅酸钠为原料制取二氧化硅并循环利用的流程：①硅酸钠溶液（A）中加入盐酸，生成硅酸沉淀（B）；②过滤并洗涤硅酸；③硅酸受热分解（△）得 SiO2（C）；④C 再溶于 NaOH 溶液回收制硅酸钠，实现循环。确定 A、B、C 并写出①③的化学方程式，说明②③④操作的目的。",
      "given": {
        "candidateSpecies": ["Na2SiO3", "H2SiO3", "SiO2"],
        "steps": [
          { "step": 1, "from": "A", "to": "B", "reagents": ["HCl"], "phenomenon": "产生白色胶状沉淀", "purpose": "酸化：向硅酸钠溶液中加盐酸生成硅酸沉淀" },
          { "step": 2, "from": "硅酸悬浊液", "to": "纯净硅酸", "purpose": "洗涤：洗去硅酸沉淀表面附着的可溶性杂质" },
          { "step": 3, "from": "B", "to": "C", "conditions": ["△"], "purpose": "灼烧：硅酸受热脱水生成SiO2" },
          { "step": 4, "from": "SiO2", "to": "硅酸钠", "reagents": ["NaOH"], "purpose": "循环利用：SiO2再溶于NaOH溶液回收制硅酸钠" }
