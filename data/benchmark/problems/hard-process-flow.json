          "id": "PROCF-H04-D1",
          "description": "氢氧化铝分解未配平（氢、氧不守恒）",
          "equation": "Al(OH)3 =△= Al2O3 + H2O",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        },
        {
          "id": "PROCF-H04-D2",
          "description": "电解氧化铝未配平（氧不守恒）",
          "equation": "Al2O3 =通电= Al + O2↑",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "tags": ["工业流程", "铝土矿炼铝", "两性氧化物"]
    },
    {
      "id": "PROCF-H05",
      "category": "IndustrialProcess",
      "difficulty": "Hard",
      "source": "人教版《化学·必修第二册》第六章'化工生产中的重要非金属元素'硫酸工业",
      "problemText": "接触法制硫酸（原料为黄铁矿）：①沸腾炉中黄铁矿高温焙烧造气得到 SO2 炉气（A，焙烧方程式超出本知识库覆盖，如实不推断）；②接触室中 A 与 O2 在催化剂、△ 条件下生成 SO3（B）；③吸收塔中 B 与水化合生成硫酸（C）；④尾气用氨水吸收残余 SO2 后达标排放；⑤未反应的 SO2、O2 二次循环氧化吸收。确定 A、B、C 并写出②③的化学方程式，说明④⑤操作的目的。",
      "given": {
        "candidateSpecies": ["SO2", "SO3", "H2SO4"],
        "steps": [
          { "step": 1, "from": "黄铁矿", "to": "SO2炉气", "conditions": ["高温"], "purpose": "焙烧造气：黄铁矿高温焙烧产生SO2" },
          { "step": 2, "from": "A", "to": "B", "reagents": ["O2"], "conditions": ["催化剂", "△"], "purpose": "催化氧化：SO2在接触室中被氧化为SO3" },
          { "step": 3, "from": "B", "to": "C", "reagents": ["H2O"], "purpose": "吸收：SO3与水化合生成硫酸" },
          { "step": 4, "from": "尾气", "to": "达标气体", "reagents": ["氨水"], "purpose": "除杂：氨水吸收尾气中残余SO2防止污染" },
          { "step": 5, "from": "转化器出口气体", "to": "接触室", "purpose": "循环利用：未反应的SO2与O2二次循环氧化吸收，提高原料利用率" }
        ]
      },
      "question": { "ask": "AnalyzeProcess", "targets": ["A、B、C物质", "②③方程式", "尾气处理与循环目的"] },
      "expected": {
        "equations": [
          "2SO2 + O2 ⇌ 2SO3",
          "SO3 + H2O = H2SO4"
        ],
        "substanceMap": { "A": "SO2", "B": "SO3", "C": "H2SO4" },
        "purposes": { "4": "不引入新杂质", "5": "循环利用" }
      },
      "distractors": [
        {
          "id": "PROCF-H05-D1",
          "description": "SO2催化氧化未配平（氧不守恒）",
          "equation": "SO2 + O2 =催化剂,△= SO3",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        },
        {
          "id": "PROCF-H05-D2",
          "description": "把可逆反应写成完全反应，且把未反应的 O2 直接写进产物，氧不守恒",
          "equation": "2SO2 + O2 = 2SO3 + O2",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "tags": ["工业流程", "接触法制硫酸", "尾气与循环"]
    },
    {
      "id": "PROCF-H06",
      "category": "IndustrialProcess",
      "difficulty": "Hard",
      "source": "人教版《化学·必修第二册》第八章'化学与可持续发展'自然资源的开发利用（废旧金属回收）",
      "problemText": "废旧锂电池回收流程：①正极片（含铝箔）用过量 NaOH 溶液碱浸溶解除去铝箔；②碱浸渣用稀硫酸与 H2O2 酸浸，LiCoO2 转化为含 Co^2+ 的浸出液；③向浸出液中加 NaOH 溶液调节 pH 沉淀铁离子（A 为铁离子，生成沉淀 B），题面未记录沉淀颜色；④除铁后的溶液加草酸铵，将 Co^2+ 转化为更难溶的 CoC2O4 沉淀回收钴。请推断 A、B 并写出③的方程式。",
