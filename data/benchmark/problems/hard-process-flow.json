          "2Al2O3 =通电,冰晶石= 4Al + 3O2↑"
        ],
        "substanceMap": { "A": "Al(OH)3", "B": "Al2O3", "C": "Al" },
        "purposes": { "1": "不引入新杂质", "2": "可溶性杂质", "3": "灼烧" }
      },
      "distractors": [
