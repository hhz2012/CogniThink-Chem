    {
      "id": "CALC-003",
      "category": "StoichiometryCalc",
      "difficulty": "Medium",
      "problemText": "10.6 g Na2CO3 与足量稀盐酸完全反应，计算标准状况下生成 CO2 的体积。",
      "given": {
        "conditions": ["足量稀盐酸", "标准状况"],
        "numericFacts": [
          { "kind": "Mass", "species": "Na2CO3", "value": "10.6", "unit": "g" }
        ]
      },
      "question": { "ask": "Calculate", "targets": ["CO2 的标准状况体积"] },
      "expected": {
        "equations": ["Na2CO3 + 2HCl = 2NaCl + H2O + CO2↑"],
        "numericAnswer": { "value": "2.24", "unit": "L", "species": "CO2" },
        "calc": { "op": "GasVolumeFromMass", "species": "Na2CO3", "massGrams": "10.6" },
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平"]
        }
      },
      "distractors": [
        {
          "id": "CALC-003-D1",
          "description": "方程式未配平（Na、Cl、H 均不守恒），计算依据错误",
          "equation": "Na2CO3 + HCl = NaCl + H2O + CO2↑",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "source": "人教版《化学·必修第一册》第二章'物质的量'综合（质量→物质的量→气体体积，Vm = 22.4 L/mol）",
      "tags": ["气体摩尔体积", "化学计量"]
    },
