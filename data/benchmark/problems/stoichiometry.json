    {
      "id": "CALC-006",
      "category": "StoichiometryCalc",
      "difficulty": "Medium",
      "problemText": "6.5 g 锌与足量稀硫酸完全反应，实际收集到氢气 0.18 g。求本次实验氢气的产率。",
      "given": {
        "numericFacts": [
          { "kind": "Mass", "species": "Zn", "value": "6.5", "unit": "g" },
          { "kind": "ActualYieldMass", "species": "H2", "value": "0.18", "unit": "g" }
        ]
      },
      "question": { "ask": "Calculate", "targets": ["H2 的产率"] },
      "expected": {
        "equations": ["Zn + H2SO4 = ZnSO4 + H2↑"],
        "numericAnswer": { "value": "9/10", "unit": "比率", "species": "H2" },
        "calc": { "op": "YieldRatio", "actualMassGrams": "9/50", "theoreticalMassGrams": "1/5" },
        "engineExpectation": {
          "isValid": true,
          "mustPass": ["白名单校验", "元素与电荷守恒", "配平", "氧化还原分析"]
        }
      },
      "distractors": [
        {
          "id": "CALC-006-D1",
          "description": "氢气系数错误：氢不守恒",
          "equation": "Zn + H2SO4 = ZnSO4 + 2H2↑",
          "expectValid": false,
          "expectFailChecks": ["元素守恒"]
        }
      ],
      "source": "人教版《化学·必修第二册》第六章'化学反应的速率与限度'（产率 = 实际产量/理论产量；M(Zn) = 65 g/mol）",
      "tags": ["产率", "理论产量"]
