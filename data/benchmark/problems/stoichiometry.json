          { "kind": "Moles", "species": "NaOH", "value": "0.5", "unit": "mol" },
          { "kind": "SolutionVolume", "value": "500", "unit": "mL" }
        ]
      },
      "question": { "ask": "Calculate", "targets": ["NaOH 的物质的量浓度"] },
      "expected": {
        "equations": [],
        "numericAnswer": { "value": "1", "unit": "mol/L", "species": "NaOH" },
        "calc": { "op": "MolarConcentration", "moles": "1/2", "solutionVolumeLiters": "1/2" },
        "engineExpectation": { "isValid": true }
      },
      "distractors": [],
      "source": "人教版《化学·必修第一册》第二章'物质的量浓度'（c = n/V）",
      "tags": ["物质的量浓度", "纯计算"]
