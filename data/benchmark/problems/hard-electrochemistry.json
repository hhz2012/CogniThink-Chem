    {
      "id": "ELEC-H01",
      "category": "Electrochemistry",
      "difficulty": "Hard",
      "problemText": "锌片和铜片用导线连接后插入硫酸铜溶液中构成原电池（溶液视为酸性介质），总反应为 Zn + Cu^2+ = Zn^2+ + Cu。写出负极和正极的电极反应式。",
      "given": {
        "medium": "acidic",
        "cell": {
          "type": "galvanic",
          "electrodes": ["Zn", "Cu"],
          "electrolyte": "CuSO4",
          "medium": "acidic",
          "overall": "Zn + Cu^2+ = Zn^2+ + Cu",
          "gasFeeds": []
        }
      },
      "question": { "ask": "WriteElectrodeEquations", "targets": ["负极电极反应式", "正极电极反应式"] },
      "expected": {
        "equations": ["Zn + Cu^2+ = Zn^2+ + Cu"],
        "electrodes": {
          "negative": "Zn = Zn^2+ + 2e^-",
          "positive": "Cu^2+ + 2e^- = Cu"
        }
      },
      "distractors": [
        {
          "id": "ELEC-H01-D1",
          "description": "负极式电子数写错（失 1 个电子），电荷不守恒",
          "equation": "Zn = Zn^2+ + e^-",
          "expectValid": false,
          "expectFailChecks": ["电荷守恒", "氧化还原分析"]
        },
        {
          "id": "ELEC-H01-D2",
          "description": "误把铜作负极氧化：该半反应本身电荷守恒，但铜在该装置中不发生氧化（与总反应矛盾）",
          "equation": "Cu = Cu^2+ + 2e^-",
          "expectValid": false,
          "expectFailChecks": ["氧化还原分析"]
        }
      ],
      "source": "人教版《化学·选择性必修1》第四章'原电池'（铜锌原电池）",
      "tags": ["电化学", "原电池", "电极反应式", "活动性顺序"]
    },
