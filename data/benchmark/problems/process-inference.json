    {
      "id": "PROC-010",
      "category": "ProcessInference",
      "difficulty": "Hard",
      "problemText": "A 是空气中含量最高的气体。A 与氢气在高温高压催化剂下化合生成 B；B 在催化剂、加热条件下被氧气氧化为无色气体 C；C 遇氧气迅速变为红棕色气体 D；D 与水反应生成强酸 E。确定 A、B、C、D、E 并写出各步反应的化学方程式。",
      "given": {
        "candidateSpecies": ["N2", "NH3", "NO", "NO2", "HNO3"],
        "steps": [
