<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CogniThink.TutorBrain</RootNamespace>
    <AssemblyName>CogniThink.TutorBrain.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CogniThink.Chem.Core\CogniThink.Chem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="data\pdf_images\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="data\vector_svg\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CogniThink.TutorBrain.Tests" />
  </ItemGroup>
</Project>
