{
  "version": "1.0",
  "source": "高中化学事实规则（电离平衡 / 胶体 / 电解质辨析 / 化学与生活）。每题四项均需被规则唯一命中、且满足问法方向的选项唯一时才断言，否则校验器返回 null。",
  "note": "verdict 表示该陈述化学上是否成立（true=成立/正确）。问法为“不正确/错误/不涉及/不能证明”时取 verdict=false 的唯一项。stemAll 为空表示不限制题干；非空时要求题干归一化文本全部包含这些关键词，用于把通用选项规则限定到对应题境，避免跨题误命中。",
  "rules": [
    {"id": "eq-005-a", "topic": "colloid", "matchAll": ["碳纳米管", "属于", "胶体"], "stemAll": ["碳纳米管"], "verdict": false, "reason": "碳纳米管是仅由碳元素组成的纯净物（单质），胶体是混合物，不属于胶体。"},
    {"id": "eq-005-b", "topic": "colloid", "matchAll": ["碳纳米管", "化合物"], "stemAll": ["碳纳米管"], "verdict": false, "reason": "碳纳米管只含碳一种元素，属于单质，不是化合物。"},
    {"id": "eq-005-c", "topic": "colloid", "matchAll": ["碳纳米管", "C60", "同素异形体"], "stemAll": ["碳纳米管"], "verdict": true, "reason": "碳纳米管与C60都是碳元素形成的不同单质，互为同素异形体。"},
    {"id": "eq-005-d", "topic": "colloid", "matchAll": ["碳纳米管", "物理变化", "C60"], "stemAll": ["碳纳米管"], "verdict": false, "reason": "C60与碳纳米管结构不同，相互转化生成新物质，属于化学变化。"},

    {"id": "eq-007-a", "topic": "colloid", "matchAll": ["云", "雾", "烟", "胶体"], "stemAll": ["分散系"], "verdict": true, "reason": "云、雾、烟都是分散质分散在空气中形成的气溶胶，属于胶体。"},
    {"id": "eq-007-b", "topic": "colloid", "matchAll": ["液溶胶", "气溶胶", "固溶胶"], "stemAll": ["分散系"], "verdict": true, "reason": "按分散剂状态不同，胶体可分为液溶胶、气溶胶和固溶胶。"},
    {"id": "eq-007-c", "topic": "colloid", "matchAll": ["硫酸钡", "粉碎", "胶体"], "stemAll": ["分散系"], "verdict": false, "reason": "胶体是分散质分散在分散剂中形成的分散系；仅将硫酸钡粉碎到1～100 nm而未分散于介质中，不构成胶体。"},
    {"id": "eq-007-d", "topic": "colloid", "matchAll": ["分散系", "9种"], "stemAll": ["分散系"], "verdict": true, "reason": "分散系都是混合物，分散质和分散剂各有气、液、固三种状态，组合共9种。"},

    {"id": "eq-008-a", "topic": "colloid", "matchAll": ["窗隙", "一束光线"], "stemAll": ["胶体"], "verdict": true, "reason": "当日光从窗隙射入观察到一束光线，是胶体的丁达尔效应，正确。"},
    {"id": "eq-008-b", "topic": "colloid", "matchAll": ["氢氧化铁胶体", "稀盐酸", "红褐色沉淀"], "stemAll": ["胶体"], "verdict": true, "reason": "向Fe(OH)3胶体中逐滴加稀盐酸，先发生聚沉产生红褐色沉淀，后沉淀溶于盐酸，正确。"},
    {"id": "eq-008-c", "topic": "colloid", "matchAll": ["饱和氯化铁", "氢氧化钠", "胶体"], "stemAll": ["胶体"], "verdict": false, "reason": "将饱和FeCl3溶液滴入NaOH溶液生成Fe(OH)3沉淀，所得分散系不是胶体；制备Fe(OH)3胶体应将饱和FeCl3滴入沸水中。"},
    {"id": "eq-008-d", "topic": "colloid", "matchAll": ["明矾", "泥水", "聚沉"], "stemAll": ["胶体"], "verdict": true, "reason": "明矾水解生成Al(OH)3胶体吸附悬浮物使泥水变澄清，与胶体的聚沉有关，正确。"},

    {"id": "eq-011-a", "topic": "life", "matchAll": ["明矾", "泥水", "澄清"], "stemAll": ["化学变化"], "verdict": true, "reason": "明矾溶于水发生水解生成Al(OH)3胶体，涉及化学变化。"},
    {"id": "eq-011-b", "topic": "life", "matchAll": ["水", "制冰"], "stemAll": ["化学变化"], "verdict": false, "reason": "水制冰只是水由液态变为固态，无新物质生成，属于物理变化，不涉及化学变化。"},
    {"id": "eq-011-c", "topic": "life", "matchAll": ["排骨汤", "醋"], "stemAll": ["化学变化"], "verdict": true, "reason": "炖排骨汤加醋，醋与骨中钙盐等反应，涉及化学变化。"},
    {"id": "eq-011-d", "topic": "life", "matchAll": ["茄子", "变色"], "stemAll": ["化学变化"], "verdict": true, "reason": "切开的茄子放置后切面变色是酚类被氧化的酶促褐变，涉及化学变化。"},

    {"id": "eq-033-a", "topic": "electrolyte", "matchAll": ["NaCl", "电流", "电离"], "stemAll": ["电解质"], "verdict": false, "reason": "电解质的电离是在水分子作用或熔融状态下离解，不需要通电。"},
    {"id": "eq-033-b", "topic": "electrolyte", "matchAll": ["强电解质", "导电性", "弱电解质"], "stemAll": ["电解质"], "verdict": false, "reason": "溶液导电性取决于离子浓度及所带电荷，强电解质稀溶液的导电性可能弱于浓的弱电解质溶液。"},
    {"id": "eq-033-c", "topic": "electrolyte", "matchAll": ["强电解质", "易溶于水"], "stemAll": ["电解质"], "verdict": false, "reason": "电解质强弱与溶解性无关，如BaSO4、AgCl难溶于水却是强电解质。"},
    {"id": "eq-033-d", "topic": "electrolyte", "matchAll": ["SO3", "非电解质", "水溶液", "导电"], "stemAll": ["电解质"], "verdict": true, "reason": "SO3本身不能电离，是非电解质；其与水反应生成强电解质H2SO4，故水溶液能导电。"},

    {"id": "eq-036-a", "topic": "electrolyte", "matchAll": ["硫酸溶液"], "stemAll": ["导电能力变化最大"], "verdict": false, "reason": "硫酸已是强电解质，加入少量NaOH生成Na2SO4，电荷浓度变化小，导电能力几乎不变。"},
    {"id": "eq-036-b", "topic": "electrolyte", "matchAll": ["氯化钠溶液"], "stemAll": ["导电能力变化最大"], "verdict": false, "reason": "NaCl溶液已有较高离子浓度，加入少量NaOH后电荷浓度变化不明显。"},
    {"id": "eq-036-c", "topic": "electrolyte", "matchAll": ["蒸馏水"], "stemAll": ["导电能力变化最大"], "verdict": true, "reason": "蒸馏水几乎不导电，加入NaOH后产生大量Na+和OH-，离子浓度剧增，导电能力变化最大。"},
    {"id": "eq-036-d", "topic": "electrolyte", "matchAll": ["盐酸"], "stemAll": ["导电能力变化最大"], "verdict": false, "reason": "盐酸中加少量NaOH生成NaCl和H2O，因NaOH量少，电荷浓度变化小，导电能力几乎不变。"},

    {"id": "eq-091-a", "topic": "equilibrium", "matchAll": ["油脂", "哈喇", "水解"], "stemAll": ["物质性质"], "verdict": false, "reason": "油脂产生哈喇味是在空气中久置被氧化酸败，不是水解反应。"},
    {"id": "eq-091-b", "topic": "equilibrium", "matchAll": ["淀粉", "亲水基团"], "stemAll": ["物质性质"], "verdict": false, "reason": "淀粉分子含多个-OH亲水基团，难溶于水是因为分子量大、结晶度高，并非不含亲水基团。"},
    {"id": "eq-091-c", "topic": "equilibrium", "matchAll": ["硝酸银", "棕色瓶", "分解"], "stemAll": ["物质性质"], "verdict": true, "reason": "AgNO3见光易分解，需避光保存于棕色试剂瓶中。"},
    {"id": "eq-091-d", "topic": "equilibrium", "matchAll": ["焰色", "黄色", "氯化钠"], "stemAll": ["物质性质"], "verdict": false, "reason": "焰色试验呈黄色只说明含Na元素，溶质可能是NaCl、NaOH、Na2CO3等，不一定是氯化钠。"},

    {"id": "eq-096-a", "topic": "equilibrium", "matchAll": ["Na2CS3", "不能", "氧化"], "stemAll": ["Na2CS3"], "verdict": false, "reason": "Na2CS3中S为-2价，具有还原性，能被氧化。"},
    {"id": "eq-096-b", "topic": "equilibrium", "matchAll": ["Na2CS3", "碱性"], "stemAll": ["Na2CS3"], "verdict": true, "reason": "Na2CS3是弱酸H2CS3的盐，S2-水解使溶液显碱性。"},
    {"id": "eq-096-c", "topic": "equilibrium", "matchAll": ["熵减"], "stemAll": ["Na2CS3"], "verdict": false, "reason": "该反应生成气体H2S，气体分子数增多，是熵增过程，不是熵减。"},
    {"id": "eq-096-d", "topic": "equilibrium", "matchAll": ["CS2", "CO2", "热稳定性"], "stemAll": ["Na2CS3"], "verdict": false, "reason": "C=S键能小于C=O，CS2的热稳定性低于CO2。"},

    {"id": "eq-124-a", "topic": "electrolyte", "matchAll": ["pH", "减小"], "stemAll": ["氯水", "Na2SO3"], "verdict": true, "reason": "Cl2与Na2SO3反应生成HCl，c(H+)增大，溶液pH减小。"},
    {"id": "eq-124-b", "topic": "electrolyte", "matchAll": ["颜色变深"], "stemAll": ["氯水", "Na2SO3"], "verdict": false, "reason": "Na2SO3还原消耗Cl2，氯水颜色应变浅而非变深。"},
    {"id": "eq-124-c", "topic": "electrolyte", "matchAll": ["漂白性", "增强"], "stemAll": ["氯水", "Na2SO3"], "verdict": false, "reason": "Cl2和HClO被Na2SO3还原消耗，漂白性应减弱而非增强。"},
    {"id": "eq-124-d", "topic": "electrolyte", "matchAll": ["导电性", "减弱"], "stemAll": ["氯水", "Na2SO3"], "verdict": false, "reason": "反应生成HCl和Na2SO4等强电解质，离子浓度增大，导电性应增强而非减弱。"},

    {"id": "eq-131-a", "topic": "equilibrium", "matchAll": ["液面上升"], "stemAll": ["氯气与水"], "verdict": false, "reason": "试管内液面上升可能只是Cl2溶于水（物理溶解），不能证明Cl2与水发生了化学反应。"},
    {"id": "eq-131-b", "topic": "equilibrium", "matchAll": ["白色沉淀"], "stemAll": ["氯气与水"], "verdict": true, "reason": "出现白色沉淀（AgCl）说明溶液中有Cl-，可证明Cl2与水反应生成了Cl-。"},
    {"id": "eq-131-c", "topic": "equilibrium", "matchAll": ["湿润", "红布条", "褪色"], "stemAll": ["氯气与水"], "verdict": true, "reason": "湿润红布条褪色说明生成了具漂白性的HClO，可证明Cl2与水反应。"},
    {"id": "eq-131-d", "topic": "equilibrium", "matchAll": ["新制氯水", "pH"], "stemAll": ["氯气与水"], "verdict": true, "reason": "新制氯水pH≈2.5说明生成了H+，可证明Cl2与水反应。"},

    {"id": "eq-264-a", "topic": "electrolyte", "matchAll": ["加热", "煮沸"], "stemAll": ["促进水的电离"], "verdict": false, "reason": "加热煮沸虽促进水的电离，但c(H+)=c(OH-)，不满足c(H+)<c(OH-)。"},
    {"id": "eq-264-b", "topic": "electrolyte", "matchAll": ["Na2CO3"], "stemAll": ["促进水的电离"], "verdict": true, "reason": "Na2CO3中CO3^2-水解结合H+，促进水的电离，溶液显碱性，c(H+)<c(OH-)。"},
    {"id": "eq-264-c", "topic": "electrolyte", "matchAll": ["氯化氢"], "stemAll": ["促进水的电离"], "verdict": false, "reason": "通入HCl使c(H+)增大，抑制水的电离。"},
    {"id": "eq-264-d", "topic": "electrolyte", "matchAll": ["NH4Cl"], "stemAll": ["促进水的电离"], "verdict": false, "reason": "NH4Cl中NH4+水解促进水的电离，但溶液显酸性，c(H+)>c(OH-)。"},

    {"id": "eq-266-a", "topic": "equilibrium", "matchAll": ["pH", "相等", "c(CH3COO", "c(Cl"], "stemAll": ["盐酸", "醋酸"], "verdict": true, "reason": "pH相等则c(H+)相等，同温下Kw相同故c(OH-)相等；由电荷守恒可得c(CH3COO-)=c(Cl-)。"},
    {"id": "eq-266-b", "topic": "equilibrium", "matchAll": ["中和", "pH", "相等", "NaOH", "相同"], "stemAll": ["盐酸", "醋酸"], "verdict": false, "reason": "pH、体积相等时醋酸浓度更大，中和消耗的NaOH更多，不相同。"},
    {"id": "eq-266-c", "topic": "equilibrium", "matchAll": ["相同浓度", "Mg", "反应速率相同"], "stemAll": ["盐酸", "醋酸"], "verdict": false, "reason": "相同浓度下盐酸完全电离、c(H+)更大，与Mg反应速率更快，两者不相同。"},
    {"id": "eq-266-d", "topic": "equilibrium", "matchAll": ["中性", "c(CH3COO", "c(Cl"], "stemAll": ["盐酸", "醋酸"], "verdict": false, "reason": "醋酸与NaOH反应至中性时c(CH3COO-)=c(Na+)，但因CH3COO-水解所需NaOH少于盐酸，故c(CH3COO-)<c(Cl-)。"},

    {"id": "eq-268-a", "topic": "electrolyte", "matchAll": ["醋酸", "盐酸", "锌", "H2"], "verdict": true, "reason": "2 mL 0.1 mol/L醋酸与盐酸的物质的量相等，与足量Zn反应时醋酸电离平衡右移，最终提供H+总量相等，生成H2的量基本相同。"},
    {"id": "eq-268-b", "topic": "electrolyte", "matchAll": ["Na2CO3", "2c(Na"], "verdict": false, "reason": "Na2CO3的物料守恒应为c(Na+)=2[c(CO3^2-)+c(HCO3-)+c(H2CO3)]，选项系数写反。"},
    {"id": "eq-268-c", "topic": "electrolyte", "matchAll": ["稀释", "c(CH3COO", "c(CH3COOH"], "verdict": false, "reason": "稀释醋酸促进电离，c(CH3COO-)/c(CH3COOH)应增大，不是减小。"},
    {"id": "eq-268-d", "topic": "electrolyte", "matchAll": ["pH=3", "pH=11", "混合", "pH>7"], "verdict": false, "reason": "pH=3的盐酸与pH=11的NaOH溶液等体积混合恰好中和，所得溶液pH=7，不是大于7。"},

    {"id": "eq-270-a", "topic": "electrolyte", "matchAll": ["NaHA", "H2A", "强酸"], "verdict": false, "reason": "NaHA溶液呈酸性，H2A可能是强酸（HA-只电离），也可能是弱酸且HA-电离程度大于水解，不一定是强酸。"},
    {"id": "eq-270-b", "topic": "electrolyte", "matchAll": ["正盐", "BA", "中性", "强酸强碱盐"], "verdict": false, "reason": "可溶性正盐BA溶液呈中性，BA不一定是强酸强碱盐，如CH3COONH4溶液也呈中性。"},
    {"id": "eq-270-c", "topic": "electrolyte", "matchAll": ["电离度", "α1<α2"], "verdict": false, "reason": "弱酸越稀越电离，0.010 mol/L醋酸的电离度α1大于0.10 mol/L的α2，即α1>α2。"},
    {"id": "eq-270-d", "topic": "electrolyte", "matchAll": ["Na2CO3", "水电离", "1.0×10"], "verdict": true, "reason": "pH=10的Na2CO3溶液中c(OH-)=10^-4 mol/L（全部来自水的电离），水电离出的H+物质的量为10^-4×0.1=1.0×10^-5 mol。"},

    {"id": "eq-276-a", "topic": "equilibrium", "matchAll": ["制备", "Fe(OH)3", "胶体"], "stemAll": ["水解"], "verdict": true, "reason": "制备Fe(OH)3胶体利用Fe3+水解，涉及水解反应。"},
    {"id": "eq-276-b", "topic": "equilibrium", "matchAll": ["硫酸", "滴定", "NaOH"], "stemAll": ["水解"], "verdict": false, "reason": "硫酸滴定NaOH是酸碱中和反应，不涉及水解反应。"},
    {"id": "eq-276-c", "topic": "equilibrium", "matchAll": ["铝盐", "净化"], "stemAll": ["水解"], "verdict": true, "reason": "铝盐净水利用Al3+水解生成Al(OH)3胶体，涉及水解反应。"},
    {"id": "eq-276-d", "topic": "equilibrium", "matchAll": ["纯碱", "油污"], "stemAll": ["水解"], "verdict": true, "reason": "纯碱去油污利用CO3^2-水解呈碱性促进油脂水解，涉及水解反应。"},

    {"id": "eq-277-a", "topic": "electrolyte", "matchAll": ["电离平衡", "水解平衡"], "stemAll": ["NaHCO3", "Na2CO3"], "verdict": true, "reason": "两溶液中均存在水的电离平衡以及HCO3-/CO3^2-的水解平衡，正确。"},
    {"id": "eq-277-b", "topic": "electrolyte", "matchAll": ["粒子种类", "相同"], "stemAll": ["NaHCO3", "Na2CO3"], "verdict": true, "reason": "NaHCO3和Na2CO3溶液中存在的粒子种类（Na+、HCO3-、CO3^2-、H2CO3、H+、OH-、H2O）相同，正确。"},
    {"id": "eq-277-c", "topic": "electrolyte", "matchAll": ["c(OH", "大于"], "stemAll": ["NaHCO3", "Na2CO3"], "verdict": false, "reason": "CO3^2-水解程度大于HCO3-，同浓度下Na2CO3溶液c(OH-)更大，故前者（NaHCO3）的c(OH-)小于后者，选项说反了。"},
    {"id": "eq-277-d", "topic": "electrolyte", "matchAll": ["NaOH", "c(CO3", "增大"], "stemAll": ["NaHCO3", "Na2CO3"], "verdict": true, "reason": "加入NaOH抑制CO3^2-水解（并使HCO3-转化为CO3^2-），两溶液中c(CO3^2-)均增大，正确。"},

    {"id": "eq-441-a", "topic": "electrolyte", "matchAll": ["硫酸铜", "饮用水", "消毒"], "stemAll": ["化学与人类生活"], "verdict": false, "reason": "Cu2+使蛋白质变性有杀菌作用，但铜离子残留对人体有害，不能用作饮用水消毒剂。"},
    {"id": "eq-441-b", "topic": "electrolyte", "matchAll": ["小苏打", "食品膨松剂"], "stemAll": ["化学与人类生活"], "verdict": true, "reason": "小苏打NaHCO3遇酸反应放出CO2，使面食疏松多孔，可用作食品膨松剂。"},
    {"id": "eq-441-c", "topic": "electrolyte", "matchAll": ["碳化硅", "固体电解质"], "stemAll": ["化学与人类生活"], "verdict": false, "reason": "碳化硅是共价晶体（结构陶瓷），无自由移动离子，不能导电，不能作固体电解质。"},
    {"id": "eq-441-d", "topic": "electrolyte", "matchAll": ["聚氯乙烯", "食品包装"], "stemAll": ["化学与人类生活"], "verdict": false, "reason": "聚氯乙烯含毒添加剂，高温下易析出，禁止用作食品包装。"},

    {"id": "eq-444-a", "topic": "equilibrium", "matchAll": ["洗洁精", "油污", "水解"], "stemAll": ["厨房"], "verdict": false, "reason": "洗洁精去油污是乳化作用（表面活性剂分散油污），不是水解反应，油污未被化学分解。"},
    {"id": "eq-444-b", "topic": "equilibrium", "matchAll": ["油", "冒烟", "稠环"], "stemAll": ["厨房"], "verdict": true, "reason": "油脂高温反复加热会生成稠环化合物等有害物质，正确。"},
    {"id": "eq-444-c", "topic": "equilibrium", "matchAll": ["食盐", "潮解", "MgCl2"], "stemAll": ["厨房"], "verdict": true, "reason": "食盐中含有的MgCl2易潮解吸水，使食盐变成糊状，正确。"},
